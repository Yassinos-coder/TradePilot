//@version=6
// ============================================================================
// TradePilot ATR Projection Strategy — trading the Weekly Volatility Map
// ----------------------------------------------------------------------------
// Strategy companion to  TradePilot_ATR_Projection_Levels.pine  (same folder).
// The indicator draws the map; this script trades it.
//
// Map (same construction as the indicator):
//   1. Anchor = last confirmed weekly close.
//   2. Project weekly-ATR notches in the weekly bias direction:
//      -2, -1.5, -1, 0, +1, +1.5, +2   (rising fib = further along the bias).
//   3. Each notch becomes a reaction zone whose height is the equilibrium of the
//      4H ATR high/low from the last completed weekly window (or Weekly ATR).
//
// Trade logic — bias-aligned only, one position at a time:
//   * ARM    a bar's range touches a zone. The approach side is recorded:
//              from the bias side -> the zone is being tested as support (bull)
//                                    / resistance (bear)        = Reaction
//              from behind        -> price is pushing through it = Breakout
//   * FIRE   a confirmed bar (the same one or a later one) closes beyond the
//            zone along the bias, optionally with a directional body, and both
//            confirmation filters agree:
//              MA       longs need price above the MA (200 by default), shorts
//                       below it — a bias long firing under the 200 MA is a
//                       contradiction. Optional MA-slope requirement on top.
//              Momentum RSI above its midline for longs / below the mirror for
//                       shorts, or a MACD histogram on the right side of zero.
//            Neither is plotted; the dashboard's Filters row says which one
//            blocked a signal. Both fail closed while still warming up.
//   * STOP   the zone's protected edge +/- an ATR buffer, or a plain ATR stop.
//   * TARGET the next notch along the bias (mid or near edge), or a fixed RR.
//   * Arms expire after N bars. A Reaction arm also dies when a bar closes
//     through the zone against the bias — the level failed.
//
// Non-repainting: every weekly / 4H value is read as  expr[1]  with
// lookahead_on, i.e. strictly the LAST CONFIRMED higher-timeframe bar. Same
// intent as the indicator, but consistent between history and realtime — the
// indicator's lookahead_off reads lag one extra weekly bar on history, so
// backtest levels here can sit one week apart from its historical drawings.
// Live, the two agree.
//
// ----------------------------------------------------------------------------
// TUNED FOR THE 2H CHART. Bar-count defaults assume ~12 bars/day, ~60/week:
//   Arm Expiry 15 bars  = 30h, about as long as a weekly level stays relevant
//                         after being touched.
//   Cooldown 6 bars     = 12h of silence after a stop-out, so the same chop
//                         cannot re-arm the notch immediately.
//   Confirmation buffer = 0.15 x chart ATR past the edge, which is what kills
//                         the marginal 2H closes that sit right on the level.
//   Max 3 trades/week, min RR 1.5 — a 2H chart arms far more often than a 4H
//                         one, so the quality gate has to be tighter.
// Above a 4H chart the zone height falls back to Weekly ATR (flagged orange on
// the dashboard).
//
// Sizing note (this bit silently kills forex backtests): risk-% sizing on an FX
// pair needs ~3x equity in notional for a real 1% risk, because per-unit risk is
// tiny. If the order is bigger than the tester's margin allows, TradingView
// REJECTS it — you see an entry marker on the chart and no trade in the report.
// "Max Position Notional" caps qty instead, and the dashboard flags the cap.
// ============================================================================

strategy("TradePilot ATR Projection Strategy", "TP ATR Strat",
     overlay                 = true,
     pyramiding              = 0,
     initial_capital         = 10000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.0,
     slippage                = 0,
     margin_long             = 0,
     margin_short            = 0,
     process_orders_on_close = true,
     // On, so the dashboard, zone boxes and Filters row stay live during the
     // forming bar. With it off, barstate.islast only becomes true once a bar
     // closes, which on a 2H chart leaves the readout up to 2h stale (CW10015).
     // It does NOT loosen the trade logic: entries are gated on
     // barstate.isconfirmed and fills happen on the close, so orders remain
     // bar-close events. Backtest results are unaffected either way — this
     // setting only changes realtime behaviour.
     calc_on_every_tick      = true,
     max_boxes_count         = 100,
     max_lines_count         = 100,
     max_labels_count        = 100)

// ============================================================================
// INPUT GROUPS
// ============================================================================
grpBias  = "Trend Detection"
grpAtr   = "ATR Projection"
grpEntry = "Entry Logic"
grpFilt  = "Confirmation Filters"
grpStop  = "Stop Loss"
grpTp    = "Take Profit"
grpSize  = "Position Sizing"
grpMgmt  = "Trade Management"
grpViz   = "Visuals"
grpDash  = "Dashboard"

// ============================================================================
// INPUTS
// ============================================================================
// Trend detection — mirrors the indicator so both agree on bias.
trendMode  = input.string("Auto", "Trend Detection", options=["Auto", "Manual"], group=grpBias)
manualDir  = input.string("Bullish", "Manual Direction", options=["Bullish", "Bearish"], group=grpBias, tooltip="Used only when Trend Detection = Manual.")
emaFastLen = input.int(50,  "Auto Fast EMA", minval=1, group=grpBias)
emaSlowLen = input.int(200, "Auto Slow EMA", minval=1, group=grpBias)

// ATR projection
atrLen             = input.int(14, "ATR Length", minval=1, group=grpAtr)
includeHalfNotches = input.bool(false, "Include Half Notches (+/- 0.5)", group=grpAtr, tooltip="Adds -0.5 and +0.5 to the ladder, matching a manual map drawn in half-weekly-ATR steps. Off by default because it also HALVES the room to the next notch: with the same zone-edge stop, RR roughly halves and most setups then fail the Minimum RR gate. Re-run the backtest before trusting it.")
zoneAtrSource      = input.string("4H ATR Equilibrium", "Zone Height", options=["4H ATR Equilibrium", "Weekly ATR"], group=grpAtr, tooltip="4H ATR Equilibrium = midpoint between the 4H ATR high/low of the last closed week. Needs a 4H-or-lower chart, otherwise Weekly ATR is used automatically.")

// Entry logic
entryMode        = input.string("Both", "Entry Trigger", options=["Reaction", "Breakout", "Both"], group=grpEntry, tooltip="Reaction = the zone held and price closed back along the bias. Breakout = price pushed through the zone along the bias.")
confirmMode      = input.string("Close Beyond Zone", "Confirmation", options=["Close Beyond Zone", "Close Beyond Midline"], group=grpEntry, tooltip="Beyond Zone = close past the zone edge (safer). Beyond Midline = close past the notch itself (earlier, more trades).")
confirmBufferAtr = input.float(0.15, "Confirmation Buffer (chart ATR)", minval=0.0, step=0.05, group=grpEntry, tooltip="The close must clear the edge / midline by this multiple of chart ATR. On 2H this is the main filter against closes that sit right on the level and reverse next bar.")
requireBody      = input.bool(true, "Require Directional Candle Body", group=grpEntry)
armExpiryBars    = input.int(15, "Arm Expiry (bars)", minval=1, group=grpEntry, tooltip="A touched zone stays tradable for this many bars while waiting for the confirmation close. 15 bars = 30h on a 2H chart.")
entryMinFib      = input.float(-2.0, "Lowest Tradable Notch", step=0.5, group=grpEntry)
entryMaxFib      = input.float(1.0,  "Highest Tradable Notch", step=0.5, group=grpEntry, tooltip="Notches count along the bias, so +2 is the most extended. Keeping the max below +2 avoids entering with no zone left to target.")

// Confirmation filters — read only, nothing is plotted. State shows on the
// dashboard's Filters row so a skipped signal can be explained.
useMaFilter = input.bool(true, "MA Trend Filter", inline="ma", group=grpFilt)
maType      = input.string("EMA", "", options=["EMA", "SMA"], inline="ma", group=grpFilt)
maLen       = input.int(200, "", minval=1, inline="ma", group=grpFilt, tooltip="Longs need price above the MA, shorts below it. A weekly-bias long that fires while price is under the 200 MA is a contradiction, and this is what blocks it.")
maTf        = input.timeframe("", "MA Timeframe", group=grpFilt, tooltip="Empty = chart timeframe. Set D for the daily 200 MA, which is what most people mean by 'the 200 MA'. Read non-repainting: last confirmed bar of that timeframe.")
useMaSlope  = input.bool(false, "Also Require MA Slope Along The Bias", group=grpFilt, tooltip="Longs also need the MA rising, shorts falling. Stricter — it rejects entries where price has crossed the MA but the MA itself is still rolling the other way.")
maSlopeBars = input.int(3, "MA Slope Lookback (bars)", minval=1, group=grpFilt, tooltip="Counted in bars of the MA Timeframe, not chart bars.")

momMode    = input.string("RSI", "Momentum Filter", options=["Off", "RSI", "MACD Histogram"], group=grpFilt, tooltip="RSI: longs need RSI above the midline, shorts below its mirror. MACD Histogram: longs need a positive histogram, shorts negative. Both read on the chart timeframe — this is entry timing, not structure.")
rsiLen     = input.int(14, "RSI Length", minval=1, inline="rsi", group=grpFilt)
rsiLevel   = input.float(50, "Midline", minval=1, maxval=99, step=1, inline="rsi", group=grpFilt, tooltip="Longs need RSI > midline, shorts need RSI < (100 - midline). 50 keeps it symmetric; 55 demands stronger momentum in both directions.")
macdFast   = input.int(12, "MACD Fast", minval=1, inline="macd", group=grpFilt)
macdSlow   = input.int(26, "Slow", minval=1, inline="macd", group=grpFilt)
macdSignal = input.int(9,  "Signal", minval=1, inline="macd", group=grpFilt)

// Stop loss
slMode    = input.string("Zone Edge + ATR Buffer", "Stop Placement", options=["Zone Edge + ATR Buffer", "ATR From Entry"], group=grpStop)
slAtrLen  = input.int(14, "Chart ATR Length", minval=1, group=grpStop)
slAtrMult = input.float(0.5, "ATR Multiplier", minval=0.1, step=0.1, group=grpStop)

// Take profit
tpMode  = input.string("Next Zone Mid", "Target", options=["Next Zone Mid", "Next Zone Near Edge", "Fixed RR"], group=grpTp)
fixedRr = input.float(2.0, "Fixed RR", minval=0.1, step=0.1, group=grpTp)
minRr   = input.float(1.5, "Minimum RR To Take Trade", minval=0.0, step=0.1, group=grpTp, tooltip="Skips setups where the stop is wide relative to the room left to the next notch — the compressed ones a 2H chart produces most often.")

// Position sizing
sizeMode    = input.string("Risk %", "Sizing Mode", options=["Risk %", "Fixed Qty"], group=grpSize)
fixedQty    = input.float(0.10, "Fixed Qty (contracts/lots)", minval=0.0, step=0.01, group=grpSize)
riskPct     = input.float(1.0,  "Risk % of Equity", minval=0.0, step=0.1, group=grpSize)
maxLeverage = input.float(5.0, "Max Position Notional (x Equity)", minval=0.1, step=0.5, group=grpSize, tooltip="Caps qty so an order is never larger than this multiple of equity. Forex needs ~3x for a true 1% risk (per-unit risk is tiny), gold ~1x. If you see entry markers on the chart but no trades in the report, the order was rejected for size: lower this, or set Properties -> Margin to 0%.")

// Trade management
maxWeekTrades = input.int(3, "Max Trades Per Week", minval=0, group=grpMgmt, tooltip="0 = unlimited. A 2H chart arms more often than a 4H one, hence 3.")
onePerLevel   = input.bool(true, "One Trade Per Notch Per Week", group=grpMgmt)
cooldownBars  = input.int(6, "Cooldown Bars After A Loss", minval=0, group=grpMgmt, tooltip="6 bars = 12h on a 2H chart. Keeps the strategy from re-arming into the same chop that just stopped it out.")
useBreakeven  = input.bool(false, "Move Stop To Breakeven", inline="be", group=grpMgmt)
beTriggerR    = input.float(1.0, "at R", minval=0.1, step=0.1, inline="be", group=grpMgmt, tooltip="Off by default. With targets a full ATR notch away the average win runs well past 1R, so scratching trades at breakeven usually costs more than the drawdown it saves. Turn it on if you prefer the smoother curve.")
biasExitRule  = input.string("On Opposite Bias", "Exit On Bias Change", options=["Never", "On Opposite Bias", "On Any Change"], group=grpMgmt, tooltip="On Any Change also closes when the weekly structure goes flat (ranging).")

// Visuals
showZones      = input.bool(true, "Show Projection Zones", group=grpViz)
showMidlines   = input.bool(true, "Show Zone Midlines", group=grpViz)
showZoneLabels = input.bool(true, "Show Zone Labels", group=grpViz)
showTradeLines = input.bool(true, "Show Trade Levels", group=grpViz)
extendLeft     = input.int(150, "Extend Left Bars", minval=10, group=grpViz)
extendRight    = input.int(80,  "Extend Right Bars", minval=10, group=grpViz)
zoneBg         = input.color(color.new(color.gray, 84), "Zone Background", group=grpViz)
zoneBorder     = input.color(color.new(color.gray, 55), "Zone Border", group=grpViz)
armedBorder    = input.color(color.new(color.aqua, 20), "Armed Zone Border", group=grpViz)
midColor       = input.color(color.new(color.black, 0), "Zone Midline", group=grpViz)
labelColor     = input.color(color.new(color.black, 0), "Zone Label Text", group=grpViz)

// Dashboard
showDash = input.bool(true, "Show Dashboard", group=grpDash)
dashPos  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpDash)

// ============================================================================
// HIGHER TIMEFRAME DATA — the last COMPLETED weekly bar.
// ----------------------------------------------------------------------------
// close[1] on the weekly series means "one week back from the weekly bar that
// CONTAINS this chart bar". That is the last completed week only while the week
// is still forming. On the bar that ends a week — Friday's close, and every
// weekend after it — the finished week is the anchor, but close[1] skips it and
// points a week further back.
//
// So fetch both offsets and pick with weekDone, true only on the chart bar that
// closes the weekly bar. On that bar the weekly close IS this bar's close, so
// nothing is read before it exists. The anchor locks in at Friday's close and
// carries unchanged through the next week.
//
// Matches TradePilot_ATR_Projection_Levels.pine so the map and the trades agree.
// ============================================================================
[wkTimeClose, wkClose0, wkClose1, wkAtr0, wkAtr1] = request.security(syminfo.tickerid, "W", [time_close, close, close[1], ta.atr(atrLen), ta.atr(atrLen)[1]], lookahead=barmerge.lookahead_on)
[wkEmaF0, wkEmaF1, wkEmaF2, wkEmaS0, wkEmaS1, wkHigh1, wkHigh2, wkLow1, wkLow2] = request.security(syminfo.tickerid, "W", [ta.ema(close, emaFastLen), ta.ema(close, emaFastLen)[1], ta.ema(close, emaFastLen)[2], ta.ema(close, emaSlowLen), ta.ema(close, emaSlowLen)[1], ta.highest(high, 3)[1], ta.highest(high, 3)[2], ta.lowest(low, 3)[1], ta.lowest(low, 3)[2]], lookahead=barmerge.lookahead_on)

weekDone = not na(wkTimeClose) and time_close >= wkTimeClose

weeklyClose       = weekDone ? wkClose0 : wkClose1
weeklyAtr         = weekDone ? wkAtr0   : wkAtr1
weeklyEmaFast     = weekDone ? wkEmaF0  : wkEmaF1
weeklyEmaSlow     = weekDone ? wkEmaS0  : wkEmaS1
weeklyEmaFastPrev = weekDone ? wkEmaF1  : wkEmaF2
weeklyStructHigh  = weekDone ? wkHigh1  : wkHigh2
weeklyStructLow   = weekDone ? wkLow1   : wkLow2

// 4H ATR equilibrium of the last completed weekly window: the manual step of
// dropping to H4, reading the ATR high/low between weekly boundaries and taking
// the midpoint as the zone height.
h4Atr     = request.security(syminfo.tickerid, "240", ta.atr(atrLen)[1], lookahead=barmerge.lookahead_on)
isNewWeek = timeframe.change("W")

var float curWeekH4High  = na
var float curWeekH4Low   = na
var float prevWeekH4High = na
var float prevWeekH4Low  = na

if isNewWeek
    prevWeekH4High := curWeekH4High
    prevWeekH4Low  := curWeekH4Low
    curWeekH4High  := h4Atr
    curWeekH4Low   := h4Atr
else
    curWeekH4High := na(curWeekH4High) ? h4Atr : math.max(curWeekH4High, h4Atr)
    curWeekH4Low  := na(curWeekH4Low)  ? h4Atr : math.min(curWeekH4Low,  h4Atr)

// The intra-week ATR high/low is sampled once per CHART bar, so above a 4H chart
// there are too few samples per week — fall back to Weekly ATR instead of
// silently degrading.
h4EqReliable = timeframe.in_seconds() <= 14400
// Same weekDone rule as the anchor: a finished week's own 4H window is the
// completed one; mid-week it is the previous week's.
h4AtrEqCur   = (not na(curWeekH4High)  and not na(curWeekH4Low))  ? (curWeekH4High  + curWeekH4Low)  / 2.0 : na
h4AtrEqPrev  = (not na(prevWeekH4High) and not na(prevWeekH4Low)) ? (prevWeekH4High + prevWeekH4Low) / 2.0 : na
h4AtrEq      = weekDone ? h4AtrEqCur : h4AtrEqPrev
h4EqUsable   = h4EqReliable and not na(h4AtrEq)
useH4Eq      = zoneAtrSource == "4H ATR Equilibrium" and h4EqUsable
zoneHeight   = useH4Eq ? h4AtrEq : weeklyAtr

chartAtr = ta.atr(slAtrLen)

// ============================================================================
// BIAS / MARKET STRUCTURE — same rules as the indicator.
// ============================================================================
autoBull      = weeklyClose > weeklyEmaFast and weeklyEmaFast > weeklyEmaSlow and weeklyEmaFast >= weeklyEmaFastPrev and weeklyClose > weeklyStructHigh
bullFallback  = weeklyClose > weeklyEmaFast and weeklyEmaFast > weeklyEmaSlow and weeklyEmaFast >= weeklyEmaFastPrev
autoBear      = weeklyClose < weeklyEmaFast and weeklyEmaFast < weeklyEmaSlow and weeklyEmaFast <= weeklyEmaFastPrev and weeklyClose < weeklyStructLow
bearFallback  = weeklyClose < weeklyEmaFast and weeklyEmaFast < weeklyEmaSlow and weeklyEmaFast <= weeklyEmaFastPrev

int direction = 0
if trendMode == "Manual"
    direction := manualDir == "Bullish" ? 1 : -1
else
    direction := autoBull or (bullFallback and not bearFallback) ? 1 : autoBear or (bearFallback and not bullFallback) ? -1 : 0

statusText  = direction == 1 ? "Bullish" : direction == -1 ? "Bearish" : "Ranging"
levelsValid = direction != 0 and not na(weeklyClose) and not na(weeklyAtr) and weeklyAtr > 0 and not na(zoneHeight) and zoneHeight > 0
halfZone    = na(zoneHeight) ? na : zoneHeight / 2.0
biasFlip    = direction != nz(direction[1], 0)

// ============================================================================
// CONFIRMATION FILTERS — read, never drawn.
// ----------------------------------------------------------------------------
// The weekly map decides WHERE to trade and the bias decides WHICH WAY. These
// two decide whether the chart agrees at the moment of the signal: a bias long
// firing while price sits under the 200 MA is a contradiction, and momentum
// below its midline says the push has not started yet.
//
// Both fail closed — while the MA or the momentum series is still warming up
// there is no confirmation, so there is no trade.
// ============================================================================
maSeries = maType == "EMA" ? ta.ema(close, maLen) : ta.sma(close, maLen)
maValue  = maTf == "" ? maSeries : request.security(syminfo.tickerid, maTf, maSeries[1], lookahead=barmerge.lookahead_on)
// Slope is measured in bars of the MA's own timeframe, so an HTF MA is compared
// against its own earlier value rather than a near-identical chart-bar reading.
maRef = maTf == "" ? maSeries[maSlopeBars] : request.security(syminfo.tickerid, maTf, maSeries[1 + maSlopeBars], lookahead=barmerge.lookahead_on)

rsiValue = ta.rsi(close, rsiLen)
[_macdLine, _macdSignalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)

maSideOk  = not useMaFilter or (not na(maValue) and (direction == 1 ? close > maValue : close < maValue))
maSlopeOk = not useMaFilter or not useMaSlope or (not na(maRef) and (direction == 1 ? maValue > maRef : maValue < maRef))
maOk      = maSideOk and maSlopeOk

momOk = momMode == "Off" ? true : momMode == "RSI" ? (not na(rsiValue) and (direction == 1 ? rsiValue > rsiLevel : rsiValue < 100 - rsiLevel)) : (not na(macdHist) and (direction == 1 ? macdHist > 0 : macdHist < 0))

// ============================================================================
// HELPERS
// ============================================================================
var float[] fibs = includeHalfNotches ? array.from(-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0) : array.from(-2.0, -1.5, -1.0, 0.0, 1.0, 1.5, 2.0)
fibCount = array.size(fibs)

projectLevel(anchor, unit, fib, dir) =>
    anchor + unit * fib * dir

fmtFib(fib) =>
    fib > 0 ? "+" + str.tostring(fib, "#.##") : str.tostring(fib, "#.##")

tradeQty(riskDist) =>
    q = 0.0
    if sizeMode == "Fixed Qty"
        q := fixedQty
    else if riskDist > 0
        riskCash = strategy.equity * riskPct / 100.0
        perUnit  = riskDist * syminfo.pointvalue
        q := perUnit > 0 ? riskCash / perUnit : 0.0
    q

// ============================================================================
// PER-WEEK STATE
// ============================================================================
var bool[] fibUsed    = array.new_bool(array.size(fibs), false)
var int    weekTrades = 0
var int    armIdx     = -1
var int    armSide    = 0   // 1 = tested from the bias side (reaction), -1 = pushing through (breakout)
var int    armBar     = na

// A new week rebuilds the anchor and the ATR unit, so every level is a new
// level. A bias flip does the same thing mid-week.
if isNewWeek or biasFlip
    for i = 0 to fibCount - 1
        array.set(fibUsed, i, false)
    weekTrades := 0
    armIdx     := -1
    armSide    := 0
    armBar     := na

// ============================================================================
// ZONE SCAN — nearest touched zone + dashboard proximity readout.
// ============================================================================
int   touchIdx    = -1
float touchDist   = na
float nearestFib  = na
float nearestMid  = na
float nearestDist = na

if levelsValid
    for i = 0 to fibCount - 1
        fib = array.get(fibs, i)
        mid = projectLevel(weeklyClose, weeklyAtr, fib, direction)
        top = mid + halfZone
        bot = mid - halfZone
        d   = math.abs(close - mid)

        if na(nearestDist) or d < nearestDist
            nearestDist := d
            nearestFib  := fib
            nearestMid  := mid

        if low <= top and high >= bot
            if touchIdx == -1 or d < touchDist
                touchIdx  := i
                touchDist := d

// ============================================================================
// ARM — remember the touched zone and which side price came from.
// ============================================================================
if touchIdx != -1
    tMid       = projectLevel(weeklyClose, weeklyAtr, array.get(fibs, touchIdx), direction)
    tTop       = tMid + halfZone
    tBot       = tMid - halfZone
    fromBias   = direction == 1 ? close[1] > tTop : close[1] < tBot
    fromBehind = direction == 1 ? close[1] < tBot : close[1] > tTop
    // Previous close inside the zone keeps the classification it already had.
    armSide := fromBias ? 1 : fromBehind ? -1 : (armIdx == touchIdx and armSide != 0 ? armSide : 1)
    armIdx  := touchIdx
    armBar  := bar_index

// ============================================================================
// DISARM — expiry, level failure, or the map going away.
// ============================================================================
if armIdx != -1
    aMid    = projectLevel(weeklyClose, weeklyAtr, array.get(fibs, armIdx), direction)
    aTop    = aMid + halfZone
    aBot    = aMid - halfZone
    expired = bar_index - armBar > armExpiryBars
    failed  = armSide == 1 and (direction == 1 ? close < aBot : close > aTop)
    if expired or failed or not levelsValid
        armIdx  := -1
        armSide := 0
        armBar  := na

// ============================================================================
// EXITS ON BIAS CHANGE — the map is rebuilt, so the thesis is gone.
// ============================================================================
if biasExitRule != "Never" and strategy.position_size != 0
    wasLong  = strategy.position_size > 0
    opposite = wasLong ? direction == -1 : direction == 1
    anyLoss  = wasLong ? direction != 1  : direction != -1
    if biasExitRule == "On Opposite Bias" ? opposite : anyLoss
        strategy.close_all(comment="bias change")
        alert("TP ATR: closed on weekly bias change", alert.freq_once_per_bar_close)

// ============================================================================
// OPEN POSITION STATE — the live bracket, tracked so it can be moved.
// ============================================================================
var float posEn       = na
var float posSl       = na
var float posTp       = na
var float posRisk     = na
var int   posDir      = 0
var bool  beMoved     = false
var int   lastLossBar = na
var float lastQty     = na
var bool  qtyCapped   = false

justClosed = strategy.position_size == 0 and strategy.position_size[1] != 0
if justClosed
    lastIdx = strategy.closedtrades - 1
    if lastIdx >= 0 and strategy.closedtrades.profit(lastIdx) < 0
        lastLossBar := bar_index
    posEn   := na
    posSl   := na
    posTp   := na
    posRisk := na
    posDir  := 0
    beMoved := false

// Breakeven is checked on the bar's extremes. On history that means it only
// applies from the NEXT bar — the stop was never actually at breakeven during the
// bar that reached the trigger, so this cannot flatter the backtest. Live, with
// calc_on_every_tick on, the move happens as soon as the tick prints, which is
// the more favourable of the two: live is never later than the backtest assumes.
if strategy.position_size != 0 and not na(posSl) and not na(posTp)
    if useBreakeven and not beMoved and not na(posRisk) and posRisk > 0
        reachedR = posDir == 1 ? high >= posEn + posRisk * beTriggerR : low <= posEn - posRisk * beTriggerR
        if reachedR
            posSl   := posEn
            beMoved := true
    if posDir == 1
        strategy.exit("Long Bracket", from_entry="TP Long", stop=posSl, limit=posTp, comment_profit="target", comment_loss=beMoved ? "breakeven" : "stop")
    else if posDir == -1
        strategy.exit("Short Bracket", from_entry="TP Short", stop=posSl, limit=posTp, comment_profit="target", comment_loss=beMoved ? "breakeven" : "stop")

// ============================================================================
// ENTRY
// ============================================================================
bool   tookLong  = false
bool   tookShort = false
float  lastEn    = na
float  lastSl    = na
float  lastTp    = na
string lastTag   = ""

flat       = strategy.position_size == 0
cooldownOk = cooldownBars == 0 or na(lastLossBar) or bar_index - lastLossBar >= cooldownBars
canTrade   = levelsValid and flat and cooldownOk and barstate.isconfirmed and not na(chartAtr) and chartAtr > 0 and (maxWeekTrades == 0 or weekTrades < maxWeekTrades)

if canTrade and armIdx != -1
    fib     = array.get(fibs, armIdx)
    mid     = projectLevel(weeklyClose, weeklyAtr, fib, direction)
    top     = mid + halfZone
    bot     = mid - halfZone
    proEdge = direction == 1 ? top : bot           // edge in the trade direction
    proTect = direction == 1 ? bot : top           // edge behind the trade — the stop side

    trigger    = (confirmMode == "Close Beyond Zone" ? proEdge : mid) + direction * confirmBufferAtr * chartAtr
    closedPast = direction == 1 ? close > trigger : close < trigger
    bodyOk     = not requireBody or (direction == 1 ? close > open : close < open)
    modeOk     = armSide == -1 ? entryMode != "Reaction" : entryMode != "Breakout"
    fibOk      = fib >= entryMinFib and fib <= entryMaxFib
    levelFree  = not onePerLevel or not array.get(fibUsed, armIdx)
    hasNext    = armIdx < fibCount - 1
    targetOk   = tpMode == "Fixed RR" or hasNext

    if closedPast and bodyOk and modeOk and fibOk and levelFree and maOk and momOk and targetOk
        en = close
        sl = slMode == "Zone Edge + ATR Buffer" ? proTect - direction * chartAtr * slAtrMult : en - direction * chartAtr * slAtrMult
        riskDist = math.abs(en - sl)

        float tp = na
        if tpMode == "Fixed RR"
            tp := en + direction * riskDist * fixedRr
        else
            nextMid = projectLevel(weeklyClose, weeklyAtr, array.get(fibs, armIdx + 1), direction)
            tp := tpMode == "Next Zone Mid" ? nextMid : nextMid - direction * halfZone

        rewardDist = direction == 1 ? tp - en : en - tp
        stopValid  = direction == 1 ? sl < en : sl > en
        rrOk       = riskDist > 0 and rewardDist > 0 and rewardDist / riskDist >= minRr

        // Cap the order at a notional the account can actually carry. Without
        // this, FX risk-% sizing asks for ~3x equity and the order is rejected —
        // an entry marker on the chart and nothing in the report.
        rawQty   = tradeQty(riskDist)
        unitCost = close * syminfo.pointvalue
        capQty   = unitCost > 0 ? strategy.equity * maxLeverage / unitCost : rawQty
        q        = math.min(rawQty, capQty)

        if stopValid and rrOk and q > 0
            tag = armSide == -1 ? "breakout" : "reaction"
            if direction == 1
                strategy.entry("TP Long", strategy.long, qty=q, comment=tag + " " + fmtFib(fib))
                strategy.exit("Long Bracket", from_entry="TP Long", stop=sl, limit=tp, comment_profit="target", comment_loss="stop")
                tookLong := true
            else
                strategy.entry("TP Short", strategy.short, qty=q, comment=tag + " " + fmtFib(fib))
                strategy.exit("Short Bracket", from_entry="TP Short", stop=sl, limit=tp, comment_profit="target", comment_loss="stop")
                tookShort := true

            lastEn    := en
            lastSl    := sl
            lastTp    := tp
            lastTag   := tag + " " + fmtFib(fib)
            lastQty   := q
            qtyCapped := rawQty > capQty
            posEn     := en
            posSl     := sl
            posTp     := tp
            posRisk   := riskDist
            posDir    := direction
            beMoved   := false
            array.set(fibUsed, armIdx, true)
            weekTrades += 1
            armIdx  := -1
            armSide := 0
            armBar  := na

// ============================================================================
// ALERTS — wire up once via "Any alert() function call".
// ============================================================================
if tookLong
    alert("TP ATR: LONG " + lastTag + " @ " + str.tostring(math.round_to_mintick(lastEn)), alert.freq_once_per_bar_close)
if tookShort
    alert("TP ATR: SHORT " + lastTag + " @ " + str.tostring(math.round_to_mintick(lastEn)), alert.freq_once_per_bar_close)
if justClosed
    alert("TP ATR: position closed", alert.freq_once_per_bar_close)
if biasFlip and direction != 0
    alert("TP ATR: weekly bias flipped " + statusText + " — levels rebuilt", alert.freq_once_per_bar_close)

plotshape(tookLong,  title="Long Entry",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(tookShort, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),  size=size.small)

// ============================================================================
// TRADE LEVEL DRAWINGS — replaced on every new entry.
// ============================================================================
var line  enLn  = na
var line  slLn  = na
var line  tpLn  = na
var label enLbl = na
var label slLbl = na
var label tpLbl = na

if (tookLong or tookShort) and showTradeLines
    if not na(enLn)
        line.delete(enLn)
    if not na(slLn)
        line.delete(slLn)
    if not na(tpLn)
        line.delete(tpLn)
    if not na(enLbl)
        label.delete(enLbl)
    if not na(slLbl)
        label.delete(slLbl)
    if not na(tpLbl)
        label.delete(tpLbl)
    enLn  := line.new(bar_index, lastEn, bar_index + 1, lastEn, color=color.white, style=line.style_dashed, extend=extend.right)
    slLn  := line.new(bar_index, lastSl, bar_index + 1, lastSl, color=color.red,   style=line.style_dotted, extend=extend.right)
    tpLn  := line.new(bar_index, lastTp, bar_index + 1, lastTp, color=color.green, style=line.style_dotted, extend=extend.right)
    enLbl := label.new(bar_index, lastEn, "ENTRY " + lastTag, style=label.style_label_left, textcolor=color.black, color=color.white, size=size.small)
    slLbl := label.new(bar_index, lastSl, "SL",               style=label.style_label_left, textcolor=color.white, color=color.red,   size=size.small)
    tpLbl := label.new(bar_index, lastTp, "TP",               style=label.style_label_left, textcolor=color.white, color=color.green, size=size.small)

// ============================================================================
// ZONE DRAWINGS — redrawn only on the last bar to keep the object count stable.
// ============================================================================
var box[]   zoneBoxes  = array.new_box()
var line[]  zoneLines  = array.new_line()
var label[] zoneLabels = array.new_label()

if barstate.islast
    while array.size(zoneBoxes) > 0
        box.delete(array.pop(zoneBoxes))
    while array.size(zoneLines) > 0
        line.delete(array.pop(zoneLines))
    while array.size(zoneLabels) > 0
        label.delete(array.pop(zoneLabels))

    if levelsValid and showZones
        leftX  = bar_index - extendLeft
        rightX = bar_index + extendRight

        for i = 0 to fibCount - 1
            fib = array.get(fibs, i)
            mid = projectLevel(weeklyClose, weeklyAtr, fib, direction)
            top = mid + halfZone
            bot = mid - halfZone
            armedHere = i == armIdx

            array.push(zoneBoxes, box.new(leftX, top, rightX, bot, xloc=xloc.bar_index, bgcolor=zoneBg, border_color=armedHere ? armedBorder : zoneBorder, border_width=armedHere ? 2 : 1))

            if showMidlines
                array.push(zoneLines, line.new(leftX, mid, rightX, mid, xloc=xloc.bar_index, color=midColor, width=1))

            if showZoneLabels
                tradable = fib >= entryMinFib and fib <= entryMaxFib
                used     = array.get(fibUsed, i)
                suffix   = used ? "  (traded)" : not tradable ? "  (skip)" : ""
                array.push(zoneLabels, label.new(rightX, mid, fmtFib(fib) + "  " + str.tostring(math.round_to_mintick(mid)) + suffix, xloc=xloc.bar_index, style=label.style_label_left, textcolor=labelColor, color=color.new(color.white, 100), size=size.small))

// ============================================================================
// DASHBOARD
// ============================================================================
dashPosition() =>
    dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left

zoneHeightText = (useH4Eq ? "4H ATR Eq" : "Weekly ATR") + (na(zoneHeight) ? "" : "  " + str.tostring(math.round_to_mintick(zoneHeight)))
// With no bias there is no side to confirm, so the filters read n/a rather than
// showing a verdict on a trade that could not happen anyway.
maText    = not useMaFilter ? "MA off" : direction == 0 ? "MA n/a" : maOk ? "MA ok" : "MA blocks"
momText   = momMode == "Off" ? "mom off" : direction == 0 ? "mom n/a" : momOk ? "mom ok" : "mom blocks"
filtersOk = direction == 0 or (maOk and momOk)
armedText      = armIdx == -1 ? "none" : fmtFib(array.get(fibs, armIdx)) + "  " + (armSide == -1 ? "breakout" : "reaction")
nearestText    = na(nearestMid) ? "-" : fmtFib(nearestFib) + "  " + str.tostring(math.round_to_mintick(nearestMid))
distText       = na(nearestDist) or na(weeklyAtr) or weeklyAtr <= 0 ? "-" : str.tostring(math.round(nearestDist / weeklyAtr * 100)) + "% W-ATR"

var table dash = na
if showDash and barstate.islast
    if not na(dash)
        table.delete(dash)
    dash := table.new(dashPosition(), 2, 14, frame_color=color.new(color.gray, 60), frame_width=1, border_width=1, border_color=color.new(color.gray, 80), bgcolor=color.new(color.black, 80))

    closed = strategy.closedtrades
    winR   = closed > 0 ? strategy.wintrades / closed * 100 : 0.0
    pf     = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0

    table.cell(dash, 0, 0, "TP ATR Projection", text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker,      text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)

    table.cell(dash, 0, 1, "Structure", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1, statusText, text_color=direction == 1 ? color.lime : direction == -1 ? color.red : color.yellow, text_size=size.small)

    table.cell(dash, 0, 2, "Anchor", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 2, na(weeklyClose) ? "-" : str.tostring(math.round_to_mintick(weeklyClose)), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 3, "Weekly ATR", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3, na(weeklyAtr) ? "-" : str.tostring(math.round_to_mintick(weeklyAtr)), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 4, "Zone Height", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 4, zoneHeightText, text_color=(zoneAtrSource == "4H ATR Equilibrium" and not h4EqUsable) ? color.orange : color.white, text_size=size.small)

    table.cell(dash, 0, 5, "Armed Notch", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 5, armedText, text_color=armIdx == -1 ? color.gray : color.aqua, text_size=size.small)

    table.cell(dash, 0, 6, "Nearest Notch", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 6, nearestText, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 7, "Filters", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7, maText + "  /  " + momText, text_color=filtersOk ? color.lime : color.orange, text_size=size.small)

    table.cell(dash, 0, 8, "Distance", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 8, distText, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 9, "Position", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 9, strategy.position_size > 0 ? "LONG" + (beMoved ? "  (BE)" : "") : strategy.position_size < 0 ? "SHORT" + (beMoved ? "  (BE)" : "") : cooldownOk ? "flat" : "cooldown", text_color=strategy.position_size != 0 ? color.yellow : cooldownOk ? color.gray : color.orange, text_size=size.small)

    table.cell(dash, 0, 10, "Last Qty", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 10, na(lastQty) ? "-" : str.tostring(lastQty, "#.####") + (qtyCapped ? "  (capped)" : ""), text_color=qtyCapped ? color.orange : color.white, text_size=size.small)

    table.cell(dash, 0, 11, "Trades This Week", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 11, str.tostring(weekTrades) + (maxWeekTrades == 0 ? "" : " / " + str.tostring(maxWeekTrades)), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 12, "Win Rate / PF", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(winR, "#.#") + "%  /  " + str.tostring(pf, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 13, "Sizing / Target", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 13, (sizeMode == "Risk %" ? str.tostring(riskPct, "#.##") + "%" : str.tostring(fixedQty)) + "  /  " + (tpMode == "Fixed RR" ? "1:" + str.tostring(fixedRr, "#.##") : tpMode == "Next Zone Mid" ? "next mid" : "next edge"), text_color=color.white, text_size=size.small)

var label rangeWatermark = na
if barstate.islast
    if not na(rangeWatermark)
        label.delete(rangeWatermark)
        rangeWatermark := na
    if showDash and direction == 0
        rangeWatermark := label.new(bar_index, high, "RANGING — no levels, no new trades", xloc=xloc.bar_index, style=label.style_label_down, textcolor=color.black, color=color.new(color.yellow, 15), size=size.normal)
// ============================================================================
