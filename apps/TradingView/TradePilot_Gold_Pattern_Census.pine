//@version=6
// ============================================================================
// TradePilot Gold Pattern Census   —   XAUUSD, 1H
// ----------------------------------------------------------------------------
// THIS IS NOT A STRATEGY. It places no orders and it reports no P&L.
//
// It exists to answer the questions that decide whether the H1 reversal-pattern
// idea is worth building at all. Answering them costs an afternoon; finding out
// after the strategy is written costs two weeks.
//
//   1. HOW OFTEN do double tops / bottoms and head & shoulders form on XAUUSD
//      H1? Validation needs 200+ trades, and 30+ per walk-forward window across
//      8+ windows — call it 240. At 25 qualifying setups a year we have a
//      decade of data and a strategy worth building. At six a year there is
//      nothing to validate and we stop here.
//
//   2. How many BREAK the neckline?
//
//   3. How many then RETEST it? Bulkowski's H&S figure is a 68% pullback rate.
//      That is US stocks on daily bars. Gold on H1 is neither. This measures it
//      instead of borrowing the number.
//
//   4. What is the pattern HEIGHT distribution? Height sets the stop, and the
//      stop has to clear the cost floor: at $0.30/oz round turn (FTMO's worse
//      end, not IC Markets' $0.13), a stop under $10 spends more than 3% of
//      risk on execution before the trade has done anything.
//
//   5. How many survive the R:R >= 2 filter? With the target fixed at the
//      measured move, 2R means the stop must sit within HALF the pattern
//      height. That is a geometry test, and most setups will fail it.
//
//   6. When one does qualify, does price reach the measured move before the
//      stop? Bulkowski's 51% is stocks WITH volume confirmation — which on a
//      gold CFD we do not have, because the volume field is broker tick count.
//
// ----------------------------------------------------------------------------
// WHY THIS DOES NOT REPAINT
//
// A pivot is not knowable until `pivotLen` bars have printed to its RIGHT. That
// lag is real and this script accepts it: nothing is detected, drawn, or counted
// until the pivot is confirmed, and every lifecycle transition is evaluated on
// closed bars only. No request.security, no lookahead, no exceptions.
//
// The consequence is that a pattern appears on the chart some bars after a
// human would have drawn it. That is the honest version. Any implementation
// that draws the pattern "as it forms" is showing you information that did not
// exist at the time, and its statistics are fiction.
//
// KNOWN CONSEQUENCE, stated rather than hidden: because the pattern is not
// registered until its last pivot confirms, any neckline break that happens
// INSIDE those pivotLen bars is never counted. Break counts here are therefore
// a floor, not a total. That bias is the correct direction — it undercounts
// opportunity rather than inventing it — but raising pivotLen widens it, so
// read the Broke% column with the pivot length in mind.
//
// ----------------------------------------------------------------------------
// LIFECYCLE
//
//   FORMED       geometry valid on confirmed pivots
//   BROKEN       a bar CLOSES beyond the neckline
//   RETEST       price returns to within tolerance of the neckline
//   ENTRY        a bar closes back beyond the neckline — the retest held
//   QUALIFIED    R:R at that entry, with the stop beyond the retest extreme
//                plus an ATR buffer, meets the minimum
//   RESOLVED     target or stop reached first
//
//   INVALIDATED  price reclaims the pattern extreme before entry
//                (Yassine's rule: reclaim the low of the W and the setup is off)
//   EXPIRED      no neckline break within the expiry window
// ============================================================================

indicator("TradePilot Gold Pattern Census", "TP Census", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================================================================
// INPUTS
// ============================================================================
grpDet  = "Detection"
grpGeo  = "Geometry Tolerances"
grpLife = "Lifecycle"
grpRR   = "Risk / Reward Filter"
grpDisp = "Display"

pivotLen = input.int(5, "Pivot Length", minval=2, maxval=50, group=grpDet, tooltip="Bars required either side of a swing before it counts. Larger = fewer, more significant patterns and more detection lag. This is the single most influential parameter here, so it goes in the variant log.")
atrLen   = input.int(14, "ATR Length", minval=1, group=grpDet)

useDB  = input.bool(true, "Double Bottom", inline="w", group=grpDet)
useIHS = input.bool(true, "Inverse H&S",   inline="w", group=grpDet)
useDT  = input.bool(true, "Double Top",    inline="m", group=grpDet)
useHS  = input.bool(true, "Head & Shoulders", inline="m", group=grpDet)

levelTolAtr  = input.float(0.60, "Level Tolerance (ATR)", minval=0.05, step=0.05, group=grpGeo, tooltip="How far apart the two tops — or the two shoulders — may sit and still count as 'the same level'. Yassine's point: price never draws these perfectly. Scaled by ATR because $5 apart means something different at 1800 than at 4300.")
minHeightAtr = input.float(1.50, "Minimum Height (ATR)", minval=0.25, step=0.25, group=grpGeo, tooltip="Neckline to pattern extreme. Rejects noise-sized formations whose measured move could never cover spread.")
necklineMode = input.string("Conservative", "Neckline From", options=["Conservative", "Nearest"], group=grpGeo, tooltip="Conservative = the harder level to break (higher of the two peaks for W-shapes, lower of the two troughs for M-shapes). Nearest = the most recent one. Horizontal either way — a sloped neckline adds a slope-tolerance parameter we would then have to defend.")

expiryBars    = input.int(100, "Expire Unbroken After (bars)", minval=10, group=grpLife)
retestTolAtr  = input.float(0.25, "Retest Tolerance (ATR)", minval=0.05, step=0.05, group=grpLife)
retestMaxBars = input.int(30, "Max Bars Break to Retest", minval=1, group=grpLife)
tradeMaxBars  = input.int(200, "Max Bars to Resolve", minval=10, group=grpLife)

minRR      = input.float(2.0, "Minimum R:R", minval=0.5, step=0.5, group=grpRR, tooltip="Target is the measured move. Reward is therefore fixed by the pattern, so this is really a cap on stop distance: at 2R the stop must sit within half the pattern height.")
stopBufAtr = input.float(0.50, "Stop Buffer Beyond Retest Extreme (ATR)", minval=0.0, step=0.25, group=grpRR, tooltip="Gold wicks. Without a buffer the structural stop gets picked off by noise that had nothing to do with the setup being wrong.")

// Default view is deliberately minimal: the pivots that DEFINE the pattern and
// the neckline, nothing else. Everything below is opt-in, because the point of
// the drawing is to audit detection — and you cannot audit what you cannot read.
drawMode      = input.string("All Detected", "Draw Skeletons", options=["All Detected", "Off"], group=grpDisp, tooltip="The pivots the pattern was actually built from, joined, plus its neckline. TradingView caps drawings at 500 so the oldest are dropped — scroll to recent bars to audit.")
necklineExtend = input.int(12, "Neckline Extension (bars)", minval=0, maxval=100, group=grpDisp)
labelOffsetAtr = input.float(0.40, "Label Offset From Price (ATR)", minval=0.0, maxval=5.0, step=0.1, group=grpDisp, tooltip="Pushes tags clear of the candles they mark. Scaled by ATR so the gap looks the same whether gold is ranging or expanding — a fixed dollar offset would crowd the chart in quiet weeks and float away in volatile ones.")
showTrendLeg  = input.bool(false, "Show Prior Swing Leg", group=grpDisp, tooltip="The move the pattern reverses. Context, not structure — off by default.")
showBreakMark = input.bool(false, "Mark Neckline Breaks", group=grpDisp)
showPatterns  = input.bool(false, "Mark Qualified Entries", group=grpDisp, tooltip="Triangle at entry with stop and target lines.")
showTable    = input.bool(true, "Show Census Table", group=grpDisp)
tablePos     = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpDisp)

atr = ta.atr(atrLen)

// ============================================================================
// TYPES
// ============================================================================
type Pivot
    float price
    int   bar

type Pattern
    string kind
    bool   bullish
    float  neckline
    float  extreme
    float  height
    int    formedBar
    int    brokenBar
    int    retestBar
    float  retestExtreme
    float  entry
    float  stop
    float  target
    float  rr
    float  mfeR
    int    ledgerIdx
    bool   broken
    bool   touched
    bool   entered
    bool   qualified
    bool   stopped
    bool   laterTarget
    bool   resolved
    bool   won
    bool   dead

// ============================================================================
// STATE
// ============================================================================
var array<Pivot>   highs  = array.new<Pivot>()
var array<Pivot>   lows   = array.new<Pivot>()
var array<Pattern> live   = array.new<Pattern>()

var array<string> kinds = array.from("Double Bottom", "Inverse H&S", "Double Top", "Head & Shoulders")

var array<int>   nFormed = array.from(0, 0, 0, 0)
var array<int>   nBroken = array.from(0, 0, 0, 0)
var array<int>   nRetest = array.from(0, 0, 0, 0)
var array<int>   nQual   = array.from(0, 0, 0, 0)
var array<int>   nWon    = array.from(0, 0, 0, 0)
var array<int>   nLost   = array.from(0, 0, 0, 0)
var array<float> hDollar = array.new<float>()
var array<float> hAtr    = array.new<float>()
var array<int>   hKind   = array.new<int>()
var array<float> stopsQ  = array.new<float>()

// ----------------------------------------------------------------------------
// TRADE LEDGER — one entry per qualified trade, used for the edge diagnostics.
//
// mfeR is the maximum FAVOURABLE excursion in R, recorded only while the trade
// was still live (the bar that hits the stop is excluded, so the number is what
// a fixed target could actually have captured, not hindsight).
//
// From mfeR alone we can price ANY fixed target without re-running: a target of
// X R would have paid X whenever mfeR >= X, and lost 1R otherwise. That turns
// one pass into a full target sweep, and it separates two very different
// failures — "the pattern has no edge" from "the pattern has an edge and our
// target is in the wrong place".
// ----------------------------------------------------------------------------
var array<float> tradeMfeR = array.new<float>()
var array<float> tradeRR   = array.new<float>()
var array<bool>  tradeWon  = array.new<bool>()
var array<bool>  tradeStop = array.new<bool>()
var array<bool>  tradeLate = array.new<bool>()

kindIndex(string k) =>
    k == "Double Bottom" ? 0 : k == "Inverse H&S" ? 1 : k == "Double Top" ? 2 : 3

// Median of the entries belonging to one pattern kind. Rebuilt on the last bar
// only, so the repeated scan costs nothing.
medianFor(array<float> vals, int k) =>
    tmp = array.new<float>()
    if array.size(vals) > 0
        for i = 0 to array.size(vals) - 1
            if array.get(hKind, i) == k
                array.push(tmp, array.get(vals, i))
    array.size(tmp) > 0 ? array.median(tmp) : na

// ============================================================================
// PIVOT COLLECTION
// ----------------------------------------------------------------------------
// ta.pivothigh/low return the pivot's PRICE on the bar that confirms it, which
// is pivotLen bars after the pivot itself. bar_index - pivotLen is therefore the
// bar the swing actually sits on.
// ============================================================================
ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)

newHigh = false
newLow  = false

if not na(ph)
    array.push(highs, Pivot.new(ph, bar_index - pivotLen))
    if array.size(highs) > 12
        array.shift(highs)
    newHigh := true

if not na(pl)
    array.push(lows, Pivot.new(pl, bar_index - pivotLen))
    if array.size(lows) > 12
        array.shift(lows)
    newLow := true

// NOTE on every loop below: `for i = 0 to array.size(x) - 1` is NOT safe on an
// empty array in Pine. Size 0 makes the bound -1, and Pine resolves `0 to -1` by
// counting DOWNWARD — so the body runs at i = 0 and array.get blows up. Each
// loop is therefore guarded by an explicit size check.

// Highest pivot high strictly between two bars. Returns the PIVOT, not just the
// price — the bar index is needed to draw the skeleton so the detection can be
// audited by eye.
highBetween(int a, int b) =>
    Pivot best = na
    if array.size(highs) > 0
        for i = 0 to array.size(highs) - 1
            p = array.get(highs, i)
            if p.bar > a and p.bar < b
                best := na(best) or p.price > best.price ? p : best
    best

// Lowest pivot low strictly between two bars.
lowBetween(int a, int b) =>
    Pivot best = na
    if array.size(lows) > 0
        for i = 0 to array.size(lows) - 1
            p = array.get(lows, i)
            if p.bar > a and p.bar < b
                best := na(best) or p.price < best.price ? p : best
    best

// The last pivot high before a bar — used to prove there was a decline INTO the
// pattern. Without a prior swing to reverse, a W is just two lows in a row.
lastHighBefore(int b) =>
    Pivot best = na
    if array.size(highs) > 0
        for i = 0 to array.size(highs) - 1
            p = array.get(highs, i)
            if p.bar < b
                best := p
    best

lastLowBefore(int b) =>
    Pivot best = na
    if array.size(lows) > 0
        for i = 0 to array.size(lows) - 1
            p = array.get(lows, i)
            if p.bar < b
                best := p
    best

// Registers a pattern and, unless drawing is off, plots the skeleton it was
// actually built from: the pivots joined in sequence, plus the neckline. Without
// this the census reports numbers nobody can check.
register(string kind, bool bullish, float neckline, float extreme, int formedBar, array<Pivot> skel, Pivot priorPivot) =>
    h = math.abs(neckline - extreme)
    array.push(live, Pattern.new(kind, bullish, neckline, extreme, h, formedBar, na, na, na, na, na, na, na, na, na, false, false, false, false, false, false, false, false, false))
    idx = kindIndex(kind)
    array.set(nFormed, idx, array.get(nFormed, idx) + 1)
    array.push(hDollar, h)
    array.push(hAtr, h / atr)
    array.push(hKind, idx)

    if drawMode == "All Detected"
        n = array.size(skel)
        first = array.get(skel, 0)
        last  = array.get(skel, n - 1)

        // Tag names follow the reference layout: the two extremes that define
        // the level, and the neckline pivot between them. Five-point skeletons
        // are head & shoulders, so the shoulders and head get named instead.
        tags = n == 5 ? array.from("LS", "NK", "H", "NK", "RS") : array.from(bullish ? "B1" : "T1", "NK", bullish ? "B2" : "T2")

        // Prior swing leg — the move the pattern is reversing. Context rather
        // than structure, so it stays off unless asked for.
        if showTrendLeg and not na(priorPivot)
            line.new(priorPivot.bar, priorPivot.price, first.bar, first.price, color=color.new(color.gray, 55), width=1, style=line.style_dashed)

        for i = 0 to n - 2
            a = array.get(skel, i)
            b = array.get(skel, i + 1)
            line.new(a.bar, a.price, b.bar, b.price, color=color.new(color.orange, 30), width=1, style=line.style_dotted)

        // On a W the extremes are troughs and the neckline pivot is a peak; on
        // an M it is the other way round. That decides which side of the candle
        // each tag sits, and therefore which way the offset pushes it.
        off = labelOffsetAtr * atr
        for i = 0 to n - 1
            p = array.get(skel, i)
            tag = array.get(tags, i)
            isNeck = tag == "NK"
            tagCol = isNeck ? color.orange : i == 0 ? color.red : i == n - 1 ? color.blue : color.red
            isLow = bullish ? not isNeck : isNeck
            label.new(p.bar, p.price + (isLow ? -off : off), tag, style=isLow ? label.style_label_down : label.style_label_up, color=tagCol, textcolor=color.white, size=size.tiny)

        // Neckline spans the pattern plus a short extension — not the full
        // expiry window, which turned the chart into a grid of stray lines.
        line.new(first.bar, neckline, last.bar + necklineExtend, neckline, color=color.new(color.gray, 20), width=1, style=line.style_dashed)

// ============================================================================
// DETECTION — W SHAPES (bullish)
// ============================================================================
if newLow and array.size(lows) >= 2
    l2 = array.get(lows, array.size(lows) - 1)
    l1 = array.get(lows, array.size(lows) - 2)
    neck = highBetween(l1.bar, l2.bar)
    prior = lastHighBefore(l1.bar)

    if useDB and not na(neck) and not na(prior)
        levelOk  = math.abs(l1.price - l2.price) <= levelTolAtr * atr
        deepest  = math.min(l1.price, l2.price)
        heightOk = neck.price - math.max(l1.price, l2.price) >= minHeightAtr * atr
        trendOk  = prior.price - l1.price >= minHeightAtr * atr
        if levelOk and heightOk and trendOk
            register("Double Bottom", true, neck.price, deepest, l2.bar, array.from(l1, neck, l2), prior)

    // Inverse H&S: three troughs, middle lowest, outer two level-ish.
    if useIHS and array.size(lows) >= 3
        ls = array.get(lows, array.size(lows) - 3)
        hd = array.get(lows, array.size(lows) - 2)
        rs = array.get(lows, array.size(lows) - 1)
        p1 = highBetween(ls.bar, hd.bar)
        p2 = highBetween(hd.bar, rs.bar)
        if not na(p1) and not na(p2)
            headOk     = hd.price < ls.price and hd.price < rs.price
            shouldersOk = math.abs(ls.price - rs.price) <= levelTolAtr * atr
            neckIhs    = necklineMode == "Conservative" ? math.max(p1.price, p2.price) : p2.price
            heightOk   = neckIhs - hd.price >= minHeightAtr * atr
            if headOk and shouldersOk and heightOk
                register("Inverse H&S", true, neckIhs, hd.price, rs.bar, array.from(ls, p1, hd, p2, rs), lastHighBefore(ls.bar))

// ============================================================================
// DETECTION — M SHAPES (bearish)
// ============================================================================
if newHigh and array.size(highs) >= 2
    h2 = array.get(highs, array.size(highs) - 1)
    h1 = array.get(highs, array.size(highs) - 2)
    neck = lowBetween(h1.bar, h2.bar)
    prior = lastLowBefore(h1.bar)

    if useDT and not na(neck) and not na(prior)
        levelOk  = math.abs(h1.price - h2.price) <= levelTolAtr * atr
        highest  = math.max(h1.price, h2.price)
        heightOk = math.min(h1.price, h2.price) - neck.price >= minHeightAtr * atr
        trendOk  = h1.price - prior.price >= minHeightAtr * atr
        if levelOk and heightOk and trendOk
            register("Double Top", false, neck.price, highest, h2.bar, array.from(h1, neck, h2), prior)

    if useHS and array.size(highs) >= 3
        ls = array.get(highs, array.size(highs) - 3)
        hd = array.get(highs, array.size(highs) - 2)
        rs = array.get(highs, array.size(highs) - 1)
        t1 = lowBetween(ls.bar, hd.bar)
        t2 = lowBetween(hd.bar, rs.bar)
        if not na(t1) and not na(t2)
            headOk      = hd.price > ls.price and hd.price > rs.price
            shouldersOk = math.abs(ls.price - rs.price) <= levelTolAtr * atr
            neckHs      = necklineMode == "Conservative" ? math.min(t1.price, t2.price) : t2.price
            heightOk    = hd.price - neckHs >= minHeightAtr * atr
            if headOk and shouldersOk and heightOk
                register("Head & Shoulders", false, neckHs, hd.price, rs.bar, array.from(ls, t1, hd, t2, rs), lastLowBefore(ls.bar))

// ============================================================================
// LIFECYCLE
// ----------------------------------------------------------------------------
// Walked newest-to-oldest so removals do not disturb indices still to be read.
// Every transition below reads only the current closed bar.
// ============================================================================
if barstate.isconfirmed and array.size(live) > 0
    for i = array.size(live) - 1 to 0
        p = array.get(live, i)
        idx = kindIndex(p.kind)
        retestTol = retestTolAtr * atr

        // --- live trades ----------------------------------------------------
        // A stopped-out trade is NOT dropped. It keeps running so we can ask the
        // one question that separates a bad pattern from a bad stop: did price
        // go on to reach the measured move anyway?
        if p.entered and p.qualified and not p.resolved
            R = math.abs(p.entry - p.stop)
            hitStop   = p.bullish ? low  <= p.stop   : high >= p.stop
            hitTarget = p.bullish ? high >= p.target : low  <= p.target

            if not p.stopped
                if hitStop
                    p.stopped := true
                    p.won := false
                    array.set(nLost, idx, array.get(nLost, idx) + 1)
                    p.ledgerIdx := array.size(tradeMfeR)
                    array.push(tradeMfeR, nz(p.mfeR, 0.0))
                    array.push(tradeRR, p.rr)
                    array.push(tradeWon, false)
                    array.push(tradeStop, true)
                    array.push(tradeLate, false)
                else
                    fav = R > 0 ? (p.bullish ? (high - p.entry) / R : (p.entry - low) / R) : 0.0
                    p.mfeR := math.max(nz(p.mfeR, 0.0), fav)
                    if hitTarget
                        p.resolved := true
                        p.won := true
                        array.set(nWon, idx, array.get(nWon, idx) + 1)
                        array.push(tradeMfeR, nz(p.mfeR, 0.0))
                        array.push(tradeRR, p.rr)
                        array.push(tradeWon, true)
                        array.push(tradeStop, false)
                        array.push(tradeLate, false)
            else
                if hitTarget
                    p.laterTarget := true
                    p.resolved := true
                    if not na(p.ledgerIdx)
                        array.set(tradeLate, p.ledgerIdx, true)

            if not p.resolved and bar_index - p.retestBar > tradeMaxBars
                p.resolved := true

        // --- pre-entry: invalidation, break, retest, entry -------------------
        else if not p.dead and not p.entered
            reclaimed = p.bullish ? close < p.extreme : close > p.extreme

            if reclaimed
                // Yassine's rule — the setup is off, whether or not it broke.
                p.dead := true

            else if not p.broken
                broke = p.bullish ? close > p.neckline : close < p.neckline
                if broke
                    p.broken := true
                    p.brokenBar := bar_index
                    array.set(nBroken, idx, array.get(nBroken, idx) + 1)
                    if showBreakMark
                        label.new(bar_index, close + (p.bullish ? labelOffsetAtr * atr : -labelOffsetAtr * atr), "✓", style=p.bullish ? label.style_label_up : label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny, tooltip=str.format("{0} — neckline broken at {1}", p.kind, math.round(close, 2)))
                else if bar_index - p.formedBar > expiryBars
                    p.dead := true

            else
                if bar_index - p.brokenBar > retestMaxBars and not p.touched
                    p.dead := true
                else
                    inZone = p.bullish ? low <= p.neckline + retestTol : high >= p.neckline - retestTol
                    if inZone
                        if not p.touched
                            p.touched := true
                            array.set(nRetest, idx, array.get(nRetest, idx) + 1)
                        p.retestExtreme := na(p.retestExtreme) ? (p.bullish ? low : high) : (p.bullish ? math.min(p.retestExtreme, low) : math.max(p.retestExtreme, high))

                    // The retest HELD: a bar closes back beyond the neckline.
                    if p.touched and (p.bullish ? close > p.neckline : close < p.neckline) and not na(p.retestExtreme)
                        p.entered := true
                        p.retestBar := bar_index
                        p.entry := close
                        p.stop := p.bullish ? p.retestExtreme - stopBufAtr * atr : p.retestExtreme + stopBufAtr * atr
                        p.target := p.bullish ? p.neckline + p.height : p.neckline - p.height
                        risk = math.abs(p.entry - p.stop)
                        reward = math.abs(p.target - p.entry)
                        p.rr := risk > 0 ? reward / risk : 0.0
                        if p.rr >= minRR
                            p.qualified := true
                            array.set(nQual, idx, array.get(nQual, idx) + 1)
                            array.push(stopsQ, risk)
                            if showPatterns
                                label.new(bar_index, close + (p.bullish ? -labelOffsetAtr * atr : labelOffsetAtr * atr), "", style=p.bullish ? label.style_triangleup : label.style_triangledown, color=p.bullish ? color.teal : color.red, size=size.small, tooltip=str.format("{0}\nentry {1}  stop {2}  target {3}\nR:R {4}   height {5}", p.kind, math.round(p.entry, 2), math.round(p.stop, 2), math.round(p.target, 2), math.round(p.rr, 2), math.round(p.height, 1)))
                                line.new(bar_index, p.stop, bar_index + 30, p.stop, color=color.new(color.red, 30), width=1)
                                line.new(bar_index, p.target, bar_index + 30, p.target, color=color.new(color.teal, 30), width=1)
                        else
                            p.dead := true

        if p.dead or p.resolved
            array.remove(live, i)

// ============================================================================
// STATS
// ============================================================================
sum(array<int> a) =>
    int t = 0
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            t += array.get(a, i)
    t

pct(int part, int whole) =>
    whole == 0 ? "—" : str.tostring(math.round(100.0 * part / whole)) + "%"

// ----------------------------------------------------------------------------
// EDGE DIAGNOSTICS
//
// Hit rate answers "how often", expectancy answers "is there an edge". They can
// disagree: a 31% hit rate is a losing system at 2R and a strong one at 4R. The
// sweep below prices every fixed target off the recorded MFE, so we can see
// whether the measured move is simply the wrong place to be taking profit.
// ----------------------------------------------------------------------------
hitRateAt(float x) =>
    n = array.size(tradeMfeR)
    int c = 0
    if n > 0
        for i = 0 to n - 1
            if array.get(tradeMfeR, i) >= x
                c += 1
    n > 0 ? 100.0 * c / n : na

expectancyAt(float x) =>
    n = array.size(tradeMfeR)
    float t = 0.0
    if n > 0
        for i = 0 to n - 1
            t += array.get(tradeMfeR, i) >= x ? x : -1.0
    n > 0 ? t / n : na

// Measured move is not a fixed R — each pattern's R:R differs — so it is priced
// off the actual outcome rather than off MFE.
expectancyMM() =>
    n = array.size(tradeWon)
    float t = 0.0
    if n > 0
        for i = 0 to n - 1
            t += array.get(tradeWon, i) ? array.get(tradeRR, i) : -1.0
    n > 0 ? t / n : na

// Of the trades that were stopped out, how many went on to reach the measured
// move anyway? A high number means the pattern was right and the stop was wrong.
stopAutopsy() =>
    int st = 0
    int late = 0
    if array.size(tradeStop) > 0
        for i = 0 to array.size(tradeStop) - 1
            if array.get(tradeStop, i)
                st += 1
                if array.get(tradeLate, i)
                    late += 1
    [st, late]

fmtR(float v) =>
    na(v) ? "—" : (v >= 0 ? "+" : "") + str.tostring(math.round(v, 3))

// Gold trades ~5 days in 7, so a calendar year is scaled before dividing into
// bar length. Approximate by design — it only has to be right enough to answer
// "how many years of data do we need for 240 trades".
tfSec = timeframe.in_seconds()
barsPerYear = tfSec > 0 ? (365.0 * 24 * 3600 * 5 / 7) / tfSec : na
yearsSpan = na(barsPerYear) or barsPerYear <= 0 ? na : bar_index / barsPerYear

// ============================================================================
// TABLE
// ============================================================================
var table t = na

if barstate.islast and showTable
    pos = tablePos == "Top Right" ? position.top_right : tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Right" ? position.bottom_right : position.bottom_left
    if not na(t)
        table.delete(t)
    t := table.new(pos, 8, 12, border_width=1, frame_width=1, frame_color=color.gray, border_color=color.new(color.gray, 60))

    hdr = color.new(color.gray, 20)
    cell = color.new(color.black, 15)

    headers = array.from("Pattern", "Formed", "Broke", "Retest", "Qual " + str.tostring(minRR, "#.#") + "R", "Hit", "Med H $", "Med H ATR")
    for c = 0 to 7
        table.cell(t, c, 0, array.get(headers, c), text_color=color.white, bgcolor=hdr, text_size=size.small)

    for r = 0 to 3
        f = array.get(nFormed, r)
        b = array.get(nBroken, r)
        rt = array.get(nRetest, r)
        q = array.get(nQual, r)
        w = array.get(nWon, r)
        l = array.get(nLost, r)
        table.cell(t, 0, r + 1, array.get(kinds, r), text_color=color.white, bgcolor=cell, text_size=size.small)
        table.cell(t, 1, r + 1, str.tostring(f), text_color=color.white, bgcolor=cell, text_size=size.small)
        table.cell(t, 2, r + 1, str.tostring(b) + "  " + pct(b, f), text_color=color.white, bgcolor=cell, text_size=size.small)
        table.cell(t, 3, r + 1, str.tostring(rt) + "  " + pct(rt, b), text_color=color.white, bgcolor=cell, text_size=size.small)
        table.cell(t, 4, r + 1, str.tostring(q) + "  " + pct(q, rt), text_color=color.white, bgcolor=cell, text_size=size.small)
        table.cell(t, 5, r + 1, pct(w, w + l) + "  (" + str.tostring(w + l) + ")", text_color=color.white, bgcolor=cell, text_size=size.small)
        mh = medianFor(hDollar, r)
        ma = medianFor(hAtr, r)
        table.cell(t, 6, r + 1, na(mh) ? "—" : str.tostring(math.round(mh, 1)), text_color=color.white, bgcolor=cell, text_size=size.small)
        table.cell(t, 7, r + 1, na(ma) ? "—" : str.tostring(math.round(ma, 2)), text_color=color.white, bgcolor=cell, text_size=size.small)

    tf = sum(nFormed)
    tb = sum(nBroken)
    tr = sum(nRetest)
    tq = sum(nQual)
    tw = sum(nWon)
    tl = sum(nLost)
    tot = color.new(color.blue, 40)
    table.cell(t, 0, 5, "TOTAL", text_color=color.white, bgcolor=tot, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(tf), text_color=color.white, bgcolor=tot, text_size=size.small)
    table.cell(t, 2, 5, str.tostring(tb) + "  " + pct(tb, tf), text_color=color.white, bgcolor=tot, text_size=size.small)
    table.cell(t, 3, 5, str.tostring(tr) + "  " + pct(tr, tb), text_color=color.white, bgcolor=tot, text_size=size.small)
    table.cell(t, 4, 5, str.tostring(tq) + "  " + pct(tq, tr), text_color=color.white, bgcolor=tot, text_size=size.small)
    table.cell(t, 5, 5, pct(tw, tw + tl) + "  (" + str.tostring(tw + tl) + ")", text_color=color.white, bgcolor=tot, text_size=size.small)
    table.cell(t, 6, 5, array.size(hDollar) > 0 ? str.tostring(math.round(array.median(hDollar), 1)) : "—", text_color=color.white, bgcolor=tot, text_size=size.small)
    table.cell(t, 7, 5, array.size(hAtr) > 0 ? str.tostring(math.round(array.median(hAtr), 2)) : "—", text_color=color.white, bgcolor=tot, text_size=size.small)

    // --- the two lines that decide whether we build the strategy ------------
    perYearQ = na(yearsSpan) or yearsSpan <= 0 ? na : tq / yearsSpan
    medStop = array.size(stopsQ) > 0 ? array.median(stopsQ) : na
    costPct = na(medStop) or medStop <= 0 ? na : 100.0 * 0.30 / medStop

    verdict = na(perYearQ) ? "—" : str.format("{0} qualified / year over {1} yrs  →  {2} yrs to reach 240 trades", math.round(perYearQ, 1), math.round(yearsSpan, 1), perYearQ > 0 ? math.round(240 / perYearQ, 1) : 0)
    costTxt = na(costPct) ? "—" : str.format("median qualified stop ${0}  →  cost {1}% of risk at $0.30/oz", math.round(medStop, 1), math.round(costPct, 2))

    table.cell(t, 0, 6, "SAMPLE", text_color=color.white, bgcolor=hdr, text_size=size.small)
    table.cell(t, 1, 6, verdict, text_color=color.white, bgcolor=cell, text_size=size.small)
    table.merge_cells(t, 1, 6, 7, 6)
    table.cell(t, 0, 7, "COST", text_color=color.white, bgcolor=hdr, text_size=size.small)
    table.cell(t, 1, 7, costTxt, text_color=color.white, bgcolor=cell, text_size=size.small)
    table.merge_cells(t, 1, 7, 7, 7)

    // ------------------------------------------------------------------------
    // TARGET SWEEP — the edge hunt.
    //
    // Expectancy is net of cost: every trade pays roughly 0.30/medianStop in R,
    // so a gross edge of +0.05R is not an edge at all once execution is paid.
    // ------------------------------------------------------------------------
    costR = na(medStop) or medStop <= 0 ? 0.0 : 0.30 / medStop
    targets = array.from(1.0, 1.5, 2.0, 2.5, 3.0)

    table.cell(t, 0, 8, "TARGET", text_color=color.white, bgcolor=hdr, text_size=size.small)
    for c = 0 to 4
        table.cell(t, c + 1, 8, str.tostring(array.get(targets, c), "#.#") + "R", text_color=color.white, bgcolor=hdr, text_size=size.small)
    table.cell(t, 6, 8, "MeasMove", text_color=color.white, bgcolor=hdr, text_size=size.small)
    table.cell(t, 7, 8, "n", text_color=color.white, bgcolor=hdr, text_size=size.small)

    table.cell(t, 0, 9, "Hit %", text_color=color.white, bgcolor=cell, text_size=size.small)
    for c = 0 to 4
        hr = hitRateAt(array.get(targets, c))
        table.cell(t, c + 1, 9, na(hr) ? "—" : str.tostring(math.round(hr)) + "%", text_color=color.white, bgcolor=cell, text_size=size.small)
    table.cell(t, 6, 9, pct(tw, tw + tl), text_color=color.white, bgcolor=cell, text_size=size.small)
    table.cell(t, 7, 9, str.tostring(array.size(tradeMfeR)), text_color=color.white, bgcolor=cell, text_size=size.small)

    table.cell(t, 0, 10, "Exp (R, net)", text_color=color.white, bgcolor=cell, text_size=size.small)
    for c = 0 to 4
        ex = expectancyAt(array.get(targets, c))
        exNet = na(ex) ? na : ex - costR
        good = not na(exNet) and exNet > 0
        table.cell(t, c + 1, 10, fmtR(exNet), text_color=color.white, bgcolor=good ? color.new(color.green, 35) : color.new(color.red, 55), text_size=size.small)
    exMM = expectancyMM()
    exMMNet = na(exMM) ? na : exMM - costR
    table.cell(t, 6, 10, fmtR(exMMNet), text_color=color.white, bgcolor=not na(exMMNet) and exMMNet > 0 ? color.new(color.green, 35) : color.new(color.red, 55), text_size=size.small)
    table.cell(t, 7, 10, "", bgcolor=cell)

    [nStopped, nLate] = stopAutopsy()
    autopsy = nStopped == 0 ? "—" : str.format("{0} of {1} stopped trades ({2}) went on to reach the measured move anyway", nLate, nStopped, pct(nLate, nStopped))
    table.cell(t, 0, 11, "STOP", text_color=color.white, bgcolor=hdr, text_size=size.small)
    table.cell(t, 1, 11, autopsy, text_color=color.white, bgcolor=cell, text_size=size.small)
    table.merge_cells(t, 1, 11, 7, 11)
