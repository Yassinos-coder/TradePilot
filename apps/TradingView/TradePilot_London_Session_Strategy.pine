//@version=6
// ============================================================================
// TradePilot London Session Strategy   —   tuned for FX on 5m
// ----------------------------------------------------------------------------
// A mechanical build of the "time before price" London model:
//
//   1. TIME    3:00 AM New York, and a 90-minute window from it (03:00-04:30).
//              Nothing is looked at outside that window.
//   2. RANGE   the high and low established BEFORE the key time.
//   3. SWEEP   one side of that range is taken out inside the window. Which side
//              does not matter; the side that goes is the side that was holding
//              retail stops, and the trade is back the other way.
//   4. DISPLACEMENT  the confirmation. A candle that closes THROUGH a run of
//              opposing-close candles, with a body big enough to count as
//              "speed and distance". Without it there is no entry, however good
//              the sweep looked.
//   5. ENTRY   on the displacement close, or on a retrace into the order block /
//              fair value gap it left behind.
//   6. TARGET  50% of the NEW range (sweep extreme -> opposite side), or the
//              opposite extreme itself.
//
// The new range is the load-bearing idea. Once the old range high is taken, the
// dealing range is redrawn from the sweep extreme down to the old range low, and
// the entry sits in the PREMIUM of that new range by construction — which is why
// a short off the displacement close is a valid trade without waiting for a
// deeper retracement into a premium that price has already spent time in.
//
// ----------------------------------------------------------------------------
// WHAT IS MECHANISED AND WHAT IS NOT
//
// Mechanised faithfully: the key time, the 90-minute window, the pre-key-time
// range (two definitions — a session window, or the previous hourly candle, i.e.
// the "2am manipulates / 3am expands" three-candle framing), the sweep, the
// displacement test as a close through N opposing-close candles, order block and
// FVG entries, the premium/discount check against the new range, the 50%
// equilibrium target, the 1:2 minimum, and SMT divergence against a correlated
// symbol.
//
// NOT mechanised, because it is a judgement the source makes by eye: "smooth" or
// "relatively equal" lows as a target selector. The script targets the new
// range's equilibrium or its opposite extreme instead. Equal lows, when they
// exist, tend to sit near one of those anyway — but the script is not claiming to
// find them. Higher-timeframe draw on liquidity is likewise absent: it is used in
// the source to decide WHICH of several candidate legs to take, and a single
// gated window per day already does most of that filtering.
//
// ----------------------------------------------------------------------------
// DEFAULTS ARE SET FOR AN FX CFD ON 5m.
//
// The window is 90 minutes: 18 bars at 5m, 6 at 15m, 90 at 1m. Below 5m the
// displacement test starts firing on noise; above 15m there are too few bars in
// the window for a sweep AND a displacement AND a retrace to fit. The bar-count
// inputs (run lookback, limit expiry, max hold) are all 5m numbers.
//
// Sizing note carried over from the other strategies in this folder: risk-%
// sizing on an FX pair needs ~3x equity in notional for a real 1% risk, because
// per-unit risk is tiny. If the order exceeds the tester's margin, TradingView
// REJECTS it and you get an entry marker with no trade in the report. "Max
// Position Notional" caps qty instead, and the dashboard flags the cap.
// ============================================================================

strategy("TradePilot London Session Strategy", "TP LDN",
     overlay                 = true,
     pyramiding              = 0,
     initial_capital         = 10000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.0,
     slippage                = 0,
     margin_long             = 0,
     margin_short            = 0,
     process_orders_on_close = true,
     calc_on_every_tick      = true,
     max_boxes_count         = 100,
     max_bars_back           = 500)

// ============================================================================
// INPUT GROUPS
// ============================================================================
grpTime  = "1. Time (the edge)"
grpRange = "2. Range"
grpSweep = "3. Sweep / Manipulation"
grpDisp  = "4. Displacement"
grpEntry = "5. Entry"
grpSmt   = "6. SMT Divergence"
grpStop  = "7. Stop Loss"
grpTgt   = "8. Take Profit"
grpSize  = "9. Position Sizing"
grpMgmt  = "10. Trade Management"
grpViz   = "Visuals"

// ============================================================================
// INPUTS
// ============================================================================
tzName   = input.string("America/New_York", "Session Timezone", options=["America/New_York", "Europe/London", "UTC"], group=grpTime, tooltip="All session strings below are read in this timezone. New York is the correct choice even though this is the London session — the key time is defined as 3:00 AM Eastern, and Eastern handles its own DST. Setting London here would drift the window by an hour twice a year.")
winSess  = input.session("0300-0430", "Trading Window", group=grpTime, tooltip="The 90 minutes. Sweeps and entries are only looked for inside this window; an unfilled limit order is cancelled when it ends. Everything before it is range building, everything after it is management of a trade that is already on.")

rangeMode = input.string("Session Window", "Range Source", options=["Session Window", "Previous Hourly Candle"], group=grpRange, tooltip="Session Window: the high and low of the whole pre-key-time window below. Previous Hourly Candle: the high and low of the last completed 1H candle before the key time — the 2am candle — which is the three-candle framing (2am sets the range, 3am manipulates it, 4am expands). The hourly version gives a much tighter range, so it sweeps more often and produces a smaller new range to target.")
rangeSess = input.session("2000-0300", "Range Window", group=grpRange, tooltip="Used when Range Source is Session Window. 20:00-03:00 New York is the Asian range: it ends exactly at the key time, and it is the liquidity pool London is documented to run. Shorten it to 0000-0300 for a tighter range that sweeps more often.")

sweepDepth = input.float(0.0, "Minimum Sweep Depth (x ATR)", minval=0.0, step=0.05, group=grpSweep, tooltip="How far past the range edge price must trade before it counts as a sweep. 0 = any tick through. Raise it if the range edge is being clipped by single ticks that were never a real run on stops.")
needReject = input.bool(false, "Require Sweep Bar To Close Back Inside Range", group=grpSweep, tooltip="Demand the sweeping bar close back inside the range — the rejection the source describes. Off by default because displacement is the actual confirmation and this only changes WHEN the setup arms, not whether it is valid. On, it arms later and skips sweeps that keep expanding.")
allowFlip  = input.bool(true, "Allow Re-Arm If The Other Side Is Swept", group=grpSweep, tooltip="If the window takes one side and then the other, re-arm in the new direction. Off = the first side taken is the only setup for the day.")

minRun      = input.int(2, "Min Opposing Candles Closed Through", minval=1, maxval=10, group=grpDisp, tooltip="The displacement candle must close beyond the extreme of this many consecutive opposing-close candles — for a short, below the LOW of the last N up-close candles. The source counts 1, 2, 3. At 1 this is nearly any engulfing bar; at 3 it is rare on 5m. 2 is the working middle.")
runLookback = input.int(10, "Max Run Lookback (bars)", minval=1, maxval=50, group=grpDisp, tooltip="How far back to count the run of opposing candles. The run stops at the first candle that breaks it, so this is only a ceiling.")
dispBodyAtr = input.float(0.8, "Min Displacement Body (x ATR)", minval=0.0, step=0.1, group=grpDisp, tooltip="'Speed and distance', made testable. The displacement candle's BODY (not its range — a big wick is the opposite of displacement) must be at least this multiple of ATR. This is the single input that separates a real displacement from an ordinary close through two small candles, so sweep it before anything else.")
requireFvg  = input.bool(false, "Require Displacement To Leave An FVG", group=grpDisp, tooltip="Only accept a displacement that gaps — bar-2's low above the displacement bar's high for a short. Forced on when the entry mode is Limit At FVG, since there is nothing to place the order at otherwise.")

entryMode   = input.string("Market On Displacement", "Entry", options=["Market On Displacement", "Limit At FVG", "Limit At Order Block"], group=grpEntry, tooltip="Market: fill on the displacement candle's close. The source's own argument for this is that price is already in the premium of the new range, so no retracement is owed. Limit modes wait for the retrace into the gap or the order block — better price, more misses. Note that a miss costs the whole day when Max Trades Per Day is 1.")
retraceFill = input.string("Mid (50%)", "Zone Fill Level", options=["Near Edge", "Mid (50%)", "Far Edge"], group=grpEntry, tooltip="Where in the zone the limit sits. Near Edge is the first price a retrace touches (fills most often, worst price), Far Edge is the deepest (best price, most misses), Mid is the 50% — consequent encroachment on an FVG, the body midpoint on an order block.")
limitMins   = input.int(30, "Cancel Unfilled Limit After (minutes)", minval=1, group=grpEntry, tooltip="Wall-clock minutes, converted to bars for whatever timeframe the chart is on. Unfilled limits are also cancelled at the end of the window and if price reaches the stop level before filling — a setup whose invalidation trades before its entry is not a setup. A cancelled order does not consume the day's trade allowance.")
requirePrem = input.bool(true, "Entry Must Be In Premium / Discount Of New Range", group=grpEntry, tooltip="Shorts must enter above the new range's 50%, longs below it. This is what makes the trade a trade rather than a chase, and it is the condition the source uses to justify entering immediately on displacement. Turning it off mostly lets late entries through, which are the ones that fail the RR gate anyway.")

useSmt  = input.bool(false, "Require SMT Divergence", group=grpSmt, tooltip="Only take the setup if a correlated symbol FAILED to sweep its own matching range edge. Off by default because it needs a symbol you have data for and a correlation you have checked. It is a genuine filter, not a decoration — it is the one confirmation the source pairs with displacement.")
smtSym  = input.symbol("", "Correlated Symbol", group=grpSmt, tooltip="Leave blank to disable. Use the pair you would actually compare — EURUSD against GBPUSD, ES against NQ. Must have data on this timeframe or the filter blocks every trade.")
smtInv  = input.bool(false, "Symbol Is Inversely Correlated", group=grpSmt, tooltip="On for DXY against EURUSD, or any pair that moves the other way. Inverted, our buy-side sweep is compared against the correlated symbol's LOW rather than its high.")

atrLen     = input.int(14, "ATR Length", minval=1, group=grpStop)
stopMode   = input.string("Sweep Extreme + Buffer", "Stop", options=["Sweep Extreme + Buffer", "ATR From Entry"], group=grpStop, tooltip="Sweep Extreme: the stop sits beyond the manipulation wick — the level that, if traded through, says the sweep was not a sweep. This is the model's own invalidation and it does not move with the entry price. ATR From Entry is a fixed distance instead, which produces a tighter stop after a large displacement candle and a correspondingly worse hit rate.")
stopBufAtr = input.float(0.25, "Stop Buffer (x ATR)", minval=0.0, step=0.05, group=grpStop, tooltip="Added beyond the sweep extreme. The extreme is exactly where the stops that were just run sat, so a stop resting on it with no buffer is resting on the noisiest price of the session.")
stopAtrMult= input.float(1.5, "ATR Stop Multiple", minval=0.1, step=0.1, group=grpStop, tooltip="Used only when Stop = ATR From Entry.")

tpMode  = input.string("New Range 50% (Equilibrium)", "Target", options=["New Range 50% (Equilibrium)", "Opposite Range Extreme", "Fixed RR"], group=grpTgt, tooltip="The new range runs from the sweep extreme to the opposite side of the old range. 50% of it is the source's primary target and the one it says price reliably reaches; the opposite extreme is the extended target that it says price reaches less often but pays more. Fixed RR ignores structure entirely and is there for comparison runs.")
fixedRR = input.float(2.0, "Fixed RR", minval=0.5, step=0.5, group=grpTgt)
minRR   = input.float(1.5, "Minimum RR To Take Trade", minval=0.5, step=0.25, group=grpTgt, tooltip="Setups whose stop and target do not clear this are skipped rather than taken small. READ THIS WITH THE TARGET SETTING — the two interact and the source's quoted 1:2 minimum does not survive both choices. Risk runs from the displacement close back over the sweep extreme; reward to the 50% is only half the new range, so on a 30-pip Asian range the equilibrium target typically implies 1.2-1.6R and a 2.0 gate rejects almost every setup, which reads as a broken strategy rather than a strict one. The opposite extreme doubles the reward and clears 2.0 comfortably. So: 1.5 with the 50% target, or raise this to 2.0 when you switch the target to the range extreme. Do not push it far past that — the same source warns against forcing 1:5 out of a model that is not trading a bias.")

sizeMode    = input.string("Risk %", "Sizing", options=["Risk %", "Fixed Qty"], group=grpSize)
riskPct     = input.float(1.0, "Risk % Of Equity", minval=0.01, step=0.25, group=grpSize)
fixedQty    = input.float(1.0, "Fixed Qty", minval=0.0, step=0.1, group=grpSize)
maxLeverage = input.float(20.0, "Max Position Notional (x Equity)", minval=0.1, step=1.0, group=grpSize, tooltip="Caps qty so an order is never larger than this multiple of equity. It is a REJECTION GUARD, not a risk control — risk is already set by Risk % and the stop distance. Read the arithmetic before changing it: required notional = (risk% x equity / stop distance) x price. This model's stop is the sweep extreme, which is 3-4 pips on 1m and 8-10 on 5m, so a 1% risk on EURUSD needs roughly 33x equity at 1m and 13x at 5m. The 3x that suits the 2H strategies in this folder binds immediately here and silently cuts realised risk to about 0.09%, which makes every number in the report a tenth of what the settings say. Watch the dashboard's Last Qty row: orange '(capped)' means this is biting and your risk is below target.")

maxTrades = input.int(1, "Max Trades Per Day", minval=1, maxval=5, group=grpMgmt, tooltip="1 is the model: one window, one setup, done. Raise it only if you have decided the re-arm after a flip is a separate trade rather than a second chance at the same idea.")
holdMins  = input.int(120, "Max Hold (minutes, 0 = off)", minval=0, group=grpMgmt, tooltip="Wall-clock minutes, converted to bars for whatever timeframe the chart is on. A London setup that has not resolved in two hours has stopped being the trade that was taken. This was specified in BARS until a 1m run showed why that is wrong: 24 bars means two hours on 5m and twenty-four MINUTES on 1m, and it closed a working trade six pips short of a target price reached twenty minutes later. A time stop is a statement about how long an idea stays valid, which is a duration, not a bar count.")
flatSess  = input.session("0300-1200", "Force Flat Outside", group=grpMgmt, tooltip="Positions are closed at market on the first bar outside this window, whatever they are doing. It ends before the New York open on purpose — this model has no read on that session.")
useBE     = input.bool(false, "Move Stop To Breakeven", group=grpMgmt, tooltip="Off by default. The target is a fixed structural level rather than a runner, so scratching a trade at breakeven usually costs more than the drawdown it saves. Turn it on for a smoother curve at a lower expectancy.")
beTrigger = input.float(1.0, "Breakeven Trigger (R)", minval=0.1, step=0.1, group=grpMgmt)

showRange  = input.bool(true, "Show Range Box", group=grpViz)
showLevels = input.bool(true, "Show Trade Levels", group=grpViz)
showEq     = input.bool(true, "Show New Range Equilibrium", group=grpViz)
showSignal = input.bool(true, "Show Sweep & Entry Markers", group=grpViz)
shadeWin   = input.bool(true, "Shade Trading Window", group=grpViz)
showDash   = input.bool(true, "Show Dashboard", group=grpViz)
dashPos    = input.string("Top Right", "Dashboard Position", options=["Top Right", "Middle Right", "Bottom Right", "Bottom Left"], group=grpViz)

// ============================================================================
// ENVIRONMENT
// ============================================================================
// The window is 90 minutes. On a 1H chart that is one and a half bars, so the
// sweep, the displacement and the entry would all have to be the same candle.
bool intradayOk = timeframe.isintraday and timeframe.in_seconds() <= 900
bool smtOn      = useSmt and smtSym != ""
string smtTicker = smtSym == "" ? syminfo.tickerid : smtSym

float atr = ta.atr(atrLen)
bool  atrOk = not na(atr) and atr > 0
bool  envOk = intradayOk and atrOk

// Durations are specified in minutes and converted here. Bar counts silently mean
// different things on different charts, and a time stop that shortens by 5x when
// you drop a timeframe is not a setting, it is a trap.
float barMinutes    = math.max(timeframe.in_seconds() / 60.0, 0.0167)
int   holdBars      = holdMins <= 0 ? 0 : math.max(1, int(math.round(holdMins / barMinutes)))
int   limitExpiry   = math.max(1, int(math.round(limitMins / barMinutes)))

// ============================================================================
// HELPERS
// ============================================================================
// The run of consecutive opposing-close candles ending at the previous bar, and
// its extreme. This is the displacement test in the source, verbatim: "close
// below 1, 2, 3 up close candles" means close below the LOWEST LOW of that run,
// not below the last one.
runExtreme(bool wantUp, int maxLook) =>
    float ext = na
    int   cnt = 0
    for i = 1 to maxLook
        bool match = wantUp ? close[i] > open[i] : close[i] < open[i]
        if not match
            break
        ext := na(ext) ? (wantUp ? low[i] : high[i]) : (wantUp ? math.min(ext, low[i]) : math.max(ext, high[i]))
        cnt += 1
    [ext, cnt]

// nearEdge is the price a retrace reaches FIRST, whichever way the trade faces.
zonePrice(float nearEdge, float farEdge) =>
    switch retraceFill
        "Near Edge" => nearEdge
        "Far Edge"  => farEdge
        => (nearEdge + farEdge) / 2.0

orderQty(float stopDist) =>
    float baseQty = sizeMode == "Fixed Qty" ? fixedQty : (stopDist > 0 ? (strategy.equity * riskPct / 100.0) / stopDist : 0.0)
    float capQty  = close > 0 ? (strategy.equity * maxLeverage) / close : baseQty
    float q       = math.max(math.min(baseQty, capQty), 0.0)
    [q, baseQty > 0 and q < baseQty * 0.999]

// ============================================================================
// HIGHER TIMEFRAME AND CORRELATED SYMBOL READS
// ============================================================================
// [1] with lookahead_on is strictly the last CONFIRMED hourly bar — identical on
// history and in realtime. Inside the 03:00 hour that is the 02:00 candle, which
// is the one the three-candle framing wants.
[h60, l60] = request.security(syminfo.tickerid, "60", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[cH,  cL ] = request.security(smtTicker, timeframe.period, [high, low])
[cH60, cL60] = request.security(smtTicker, "60", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// ============================================================================
// SESSION FLAGS
// ============================================================================
bool inWin    = not na(time(timeframe.period, winSess, tzName))
bool winStart = inWin and not inWin[1]

bool inRng    = not na(time(timeframe.period, rangeSess, tzName))
bool rngStart = inRng and not inRng[1]

bool inFlatWin = not na(time(timeframe.period, flatSess, tzName))

int barsPerHour = math.max(1, int(3600 / math.max(timeframe.in_seconds(), 1)))

// ============================================================================
// RANGE
// ============================================================================
var float rngHi      = na
var float rngLo      = na
var int   rngStartBar = na
var float cRngHi     = na
var float cRngLo     = na

if rngStart
    rngHi       := high
    rngLo       := low
    rngStartBar := bar_index
    cRngHi      := cH
    cRngLo      := cL
else if inRng
    rngHi := math.max(nz(rngHi, high), high)
    rngLo := math.min(nz(rngLo, low), low)
    if not na(cH)
        cRngHi := na(cRngHi) ? cH : math.max(cRngHi, cH)
    if not na(cL)
        cRngLo := na(cRngLo) ? cL : math.min(cRngLo, cL)

// ============================================================================
// WINDOW STATE
// ============================================================================
var float winHi     = na
var float winLo     = na
var int   dir       = 0        // -1 short bias (buy side swept), +1 long bias
var float sweepExt  = na       // the manipulation extreme, i.e. the new range edge
var int   sweepBar  = na
var int   dayTrades = 0
var bool  cTookHigh = false
var bool  cTookLow  = false

// Per-DAY funnel. "Why didn't it trade today?" has four possible answers and the
// Strategy Tester can only ever show you the last one. Counting windows, then days
// that swept, then days that displaced, then days that traded, localises the loss:
// a big drop at the sweep stage means the range is too wide for a 90-minute window,
// at the displacement stage means the body/run filters are too strict, and at the
// trade stage means the RR or premium gates are doing the rejecting.
var int  dWindows   = 0
var int  dSwept     = 0
var int  dDisplaced = 0
var int  dTraded    = 0
var bool sweptToday = false
var bool dispToday  = false
var bool tradedToday = false

if winStart
    if rangeMode == "Previous Hourly Candle"
        rngHi       := h60
        rngLo       := l60
        rngStartBar := bar_index - barsPerHour
        cRngHi      := cH60
        cRngLo      := cL60
    winHi     := high
    winLo     := low
    dir       := 0
    sweepExt  := na
    sweepBar  := na
    dayTrades := 0
    cTookHigh := false
    cTookLow  := false
    dWindows  += 1
    sweptToday := false
    dispToday  := false
    tradedToday := false
else if inWin
    winHi := math.max(nz(winHi, high), high)
    winLo := math.min(nz(winLo, low), low)

if inWin and not na(cH) and not na(cRngHi)
    cTookHigh := cTookHigh or cH > cRngHi
if inWin and not na(cL) and not na(cRngLo)
    cTookLow := cTookLow or cL < cRngLo

// ============================================================================
// SWEEP
// ============================================================================
// Which side goes does not matter — the side that goes is the side that was
// holding the stops, and the trade is back the other way.
float sweepPad = sweepDepth * nz(atr, 0.0)
bool  rangeOk  = not na(rngHi) and not na(rngLo) and rngHi > rngLo

bool tookHigh = inWin and rangeOk and high > rngHi + sweepPad and (not needReject or close < rngHi)
bool tookLow  = inWin and rangeOk and low  < rngLo - sweepPad and (not needReject or close > rngLo)

// A bar that takes both sides is read by its own close: a bearish close means the
// buy side was the one that got run.
bool bothSides = tookHigh and tookLow
bool wantShort = tookHigh and (not bothSides or close <= open)
bool wantLong  = tookLow  and (not bothSides or close >  open)

if inWin
    if wantShort and (dir == 0 or (allowFlip and dir == 1))
        dir      := -1
        sweepExt := winHi
        sweepBar := bar_index
    else if wantLong and (dir == 0 or (allowFlip and dir == -1))
        dir      := 1
        sweepExt := winLo
        sweepBar := bar_index
    else if dir == -1
        sweepExt := math.max(nz(sweepExt, high), high)
    else if dir == 1
        sweepExt := math.min(nz(sweepExt, low), low)

bool justArmed = dir != 0 and nz(dir[1], 0) != dir

if inWin and dir != 0 and not sweptToday
    dSwept += 1
    sweptToday := true

// ============================================================================
// DISPLACEMENT
// ============================================================================
[upLow,  upCnt] = runExtreme(true,  runLookback)
[dnHigh, dnCnt] = runExtreme(false, runLookback)

float body    = math.abs(close - open)
bool  bigBody = atrOk and body >= dispBodyAtr * atr

bool fvgBear = low[2] > high
bool fvgBull = high[2] < low

bool bearSetup = dir == -1
bool bullSetup = dir == 1

bool dispShort = bearSetup and close < open and upCnt  >= minRun and not na(upLow)  and close < upLow  and bigBody
bool dispLong  = bullSetup and close > open and dnCnt  >= minRun and not na(dnHigh) and close > dnHigh and bigBody

bool needGap = requireFvg or entryMode == "Limit At FVG"
bool gapOk   = not needGap or (bearSetup ? fvgBear : fvgBull)

// Counted on the raw displacement, before the gates, so the funnel separates "no
// displacement happened" from "one happened and something rejected it".
if (dispShort or dispLong) and not dispToday
    dDisplaced += 1
    dispToday  := true

// ============================================================================
// SETUP PRICING
// ============================================================================
// The new dealing range: sweep extreme to the far side of the old range. The
// entry sits in its premium (short) or discount (long) by construction, which is
// the whole justification for entering on the displacement close.
float newHi = bearSetup ? nz(sweepExt, high) : nz(rngHi, high)
float newLo = bearSetup ? nz(rngLo, low)     : nz(sweepExt, low)
float eqPx  = (newHi + newLo) / 2.0

float fvgNear = bearSetup ? high  : low
float fvgFar  = bearSetup ? low[2] : high[2]
float obNear  = bearSetup ? low[1]  : high[1]
float obFar   = bearSetup ? high[1] : low[1]

float zoneNear = entryMode == "Limit At FVG" ? fvgNear : obNear
float zoneFar  = entryMode == "Limit At FVG" ? fvgFar  : obFar

bool  isMarket  = entryMode == "Market On Displacement"
float wantEntry = isMarket ? close : zonePrice(zoneNear, zoneFar)

float rawStop = stopMode == "Sweep Extreme + Buffer" ? (bearSetup ? nz(sweepExt, high) + stopBufAtr * nz(atr, 0.0) : nz(sweepExt, low) - stopBufAtr * nz(atr, 0.0)) : (bearSetup ? wantEntry + stopAtrMult * nz(atr, 0.0) : wantEntry - stopAtrMult * nz(atr, 0.0))
float wantStop = bearSetup ? math.max(rawStop, wantEntry + syminfo.mintick) : math.min(rawStop, wantEntry - syminfo.mintick)
float riskDist = math.abs(wantStop - wantEntry)

float wantTgt = switch tpMode
    "Opposite Range Extreme" => bearSetup ? newLo : newHi
    "Fixed RR"               => bearSetup ? wantEntry - fixedRR * riskDist : wantEntry + fixedRR * riskDist
    => eqPx

float rewardDist = bearSetup ? wantEntry - wantTgt : wantTgt - wantEntry
float setupRR    = riskDist > 0 ? rewardDist / riskDist : na

bool rrOk   = not na(setupRR) and rewardDist > 0 and setupRR >= minRR
bool premOk = not requirePrem or (bearSetup ? wantEntry >= eqPx : wantEntry <= eqPx)
bool smtOk  = not smtOn or (bearSetup ? (smtInv ? not cTookLow : not cTookHigh) : (smtInv ? not cTookHigh : not cTookLow))
// A sell limit below market or a buy limit above it is a market order wearing a
// costume — the retrace being waited for has to actually be a retrace.
bool zoneOk = isMarket or (not na(wantEntry) and (bearSetup ? wantEntry > close : wantEntry < close))

// ============================================================================
// POSITION STATE
// ============================================================================
var float  posStop   = na
var float  posTgt    = na
var int    posDir    = 0
var bool   pending   = false
var int    orderBar  = na
var string orderId   = ""
var bool   beArmed   = false

var int   shortTaken = 0
var int   longTaken  = 0
var int   exTime     = 0
var int   exFlat     = 0
var int   exExpired  = 0

var float lastRR    = na
var float lastEntry = na
var float lastStop  = na
var float lastTgt   = na
var float lastQty   = na
var bool  lastCap   = false

bool flat      = strategy.position_size == 0
bool tradesOk  = dayTrades < maxTrades
bool canTrade  = envOk and inWin and rangeOk and barstate.isconfirmed and flat and not pending and tradesOk

bool fireShort = canTrade and dispShort and gapOk and rrOk and premOk and smtOk and zoneOk
bool fireLong  = canTrade and dispLong  and gapOk and rrOk and premOk and smtOk and zoneOk and not fireShort
bool entrySignal = fireShort or fireLong

// Sized at global scope: a tuple cannot be declared inside a local block.
[qty, capped] = orderQty(riskDist)

// ============================================================================
// ENTRIES
// ============================================================================
if fireShort
    if qty > 0
        if isMarket
            strategy.entry("LDN-S", strategy.short, qty=qty, alert_message="TP LDN short")
        else
            strategy.entry("LDN-S", strategy.short, qty=qty, limit=wantEntry, alert_message="TP LDN short limit")
        posStop   := wantStop
        posTgt    := wantTgt
        posDir    := -1
        orderId   := "LDN-S"
        orderBar  := bar_index
        pending   := not isMarket
        beArmed   := false
        dayTrades += 1
        shortTaken += 1
        lastRR    := setupRR
        lastEntry := wantEntry
        lastStop  := wantStop
        lastTgt   := wantTgt
        lastQty   := qty
        lastCap   := capped
        if not tradedToday
            dTraded += 1
            tradedToday := true

if fireLong
    if qty > 0
        if isMarket
            strategy.entry("LDN-L", strategy.long, qty=qty, alert_message="TP LDN long")
        else
            strategy.entry("LDN-L", strategy.long, qty=qty, limit=wantEntry, alert_message="TP LDN long limit")
        posStop   := wantStop
        posTgt    := wantTgt
        posDir    := 1
        orderId   := "LDN-L"
        orderBar  := bar_index
        pending   := not isMarket
        beArmed   := false
        dayTrades += 1
        longTaken += 1
        lastRR    := setupRR
        lastEntry := wantEntry
        lastStop  := wantStop
        lastTgt   := wantTgt
        lastQty   := qty
        lastCap   := capped
        if not tradedToday
            dTraded += 1
            tradedToday := true

// ============================================================================
// PENDING LIMIT MANAGEMENT
// ============================================================================
// A working order dies at the end of the window, on expiry, or the moment its own
// invalidation trades — a setup whose stop is reached before its entry was never
// going to be that trade. A cancelled order gives the day's allowance back.
//
// `filled` is read from the bar's range, not from position_size. The broker
// emulator fills a limit intrabar but the position is not visible to the script
// until the next bar, so cancelling on position_size == 0 would fire a cancel at
// the same moment the order was actually filling — and on the expiry bar that
// races into an open trade the script has stopped tracking.
bool cancelled = false

// `bar_index > orderBar` is not a nicety. An order placed during this bar's
// calculation is not live with the emulator until the next bar, and the
// displacement candle's own high usually reaches back into the order block it
// just left — so testing the placement bar would read "filled" against an order
// that did not exist yet, drop the pending flag, and leave a live limit nobody
// cancels for the rest of the chart.
if pending and bar_index > orderBar
    bool touched = posDir == -1 ? high >= nz(lastEntry, high) : low <= nz(lastEntry, low)
    bool filled  = strategy.position_size != 0 or touched
    bool stopHit = not na(posStop) and (posDir == -1 ? high >= posStop : low <= posStop)
    if filled
        pending := false
    else if not inWin or bar_index - orderBar >= limitExpiry or stopHit
        strategy.cancel(orderId)
        pending   := false
        cancelled := true
        dayTrades := math.max(dayTrades - 1, 0)
        exExpired += 1

// Safety net. Reading a fill from the bar's range is one inference away from the
// emulator's own bookkeeping, so if the two ever disagree — a touch that did not
// cross, a fill on the last window bar — this guarantees nothing is left resting
// on the book after the window with no position to justify it. Placed before the
// exit block so it cannot cancel an exit written later on the same bar.
if not inWin and strategy.position_size == 0 and not pending
    strategy.cancel_all()

// ============================================================================
// EXITS
// ============================================================================
// Read the book AFTER the entry block — `flat` above is the pre-entry snapshot the
// signals gate on, and reusing it here would be a bar stale.
bool  longOpen  = strategy.position_size > 0
bool  shortOpen = strategy.position_size < 0
bool  inPos     = longOpen or shortOpen
int   fillBar   = strategy.opentrades > 0 ? strategy.opentrades.entry_bar_index(0) : -1
int   heldBars  = fillBar < 0 ? 0 : bar_index - fillBar
float fillPx    = strategy.position_avg_price
float rInit     = na(fillPx) or na(posStop) ? na : math.abs(posStop - fillPx)

if useBE and inPos and not na(rInit) and rInit > 0
    if shortOpen and low  <= fillPx - beTrigger * rInit
        beArmed := true
    if longOpen  and high >= fillPx + beTrigger * rInit
        beArmed := true

float effStop = (not beArmed or na(fillPx) or na(posStop)) ? posStop : (posDir == -1 ? math.min(posStop, fillPx) : math.max(posStop, fillPx))

// Keyed on posDir, not on an open position. An exit attached to an entry ID is
// live the instant that entry fills, so placing it on the same bar as the order
// closes the one-bar hole a position-gated exit leaves: with orders filling on
// close, `strategy.position_size` does not report the trade until the next bar,
// and the bar in between would run without a stop in the emulator.
bool levelsOk = not na(posStop) and not na(posTgt) and not cancelled

if posDir == -1 and levelsOk
    strategy.exit("X LDN-S", from_entry="LDN-S", stop=effStop, limit=posTgt)
if posDir == 1 and levelsOk
    strategy.exit("X LDN-L", from_entry="LDN-L", stop=effStop, limit=posTgt)

if inPos and holdBars > 0 and heldBars >= holdBars
    strategy.close_all(comment="Time stop")
    exTime += 1

if inPos and not inFlatWin
    strategy.close_all(comment="Session flat")
    exFlat += 1

// Levels are cleared on a real event — a trade that closed, or an order that was
// cancelled — never on "position_size is currently 0". With
// process_orders_on_close the entry bar still reports 0, and a limit fill is
// invisible for a further bar, so a reset keyed on flatness wipes posStop/posTgt
// in the gap between the order and the fill and the trade never gets an exit.
var int prevClosed = 0
bool tradeClosed = strategy.closedtrades > prevClosed
if tradeClosed
    prevClosed := strategy.closedtrades

if (tradeClosed and not inPos) or cancelled
    posStop := na
    posTgt  := na
    posDir  := 0
    beArmed := false

// ============================================================================
// VISUALS
// ============================================================================
var box rngBox = na

if showRange and winStart and rangeOk and not na(rngStartBar)
    rngBox := box.new(rngStartBar, rngHi, bar_index, rngLo, border_color=color.new(color.gray, 40), border_width=1, bgcolor=color.new(color.gray, 92))
if showRange and inWin and not na(rngBox)
    box.set_right(rngBox, bar_index)
    box.set_top(rngBox, rngHi)
    box.set_bottom(rngBox, rngLo)

bgcolor(shadeWin and inWin ? color.new(color.blue, 94) : na, title="Trading Window")

plot(showEq and inWin and dir != 0 ? eqPx : na, "New Range 50%", color=color.new(color.orange, 20), style=plot.style_linebr, linewidth=1)
plot(showLevels and inPos ? effStop : na, "Stop", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(showLevels and inPos ? posTgt : na, "Target", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=1)
plot(showLevels and pending ? lastEntry : na, "Working Limit", color=color.new(color.blue, 0), style=plot.style_linebr, linewidth=1)

plotshape(showSignal and justArmed and dir == -1, "Buy Side Swept", shape.xcross, location.abovebar, color.new(color.orange, 0), size=size.tiny)
plotshape(showSignal and justArmed and dir ==  1, "Sell Side Swept", shape.xcross, location.belowbar, color.new(color.orange, 0), size=size.tiny)
plotshape(showSignal and fireShort, "Short", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)
plotshape(showSignal and fireLong,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)

// ============================================================================
// DASHBOARD
// ============================================================================
dashLoc = switch dashPos
    "Middle Right" => position.middle_right
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.top_right

if showDash and barstate.islast
    // Opaque panel. The cells carry white and silver text, which is invisible on a
    // light-theme chart with a transparent table behind it — the dashboard has to
    // supply its own contrast rather than borrow the chart's.
    var table dash = table.new(dashLoc, 2, 17, bgcolor=color.new(#131722, 8), border_width=1, frame_width=1, frame_color=color.new(color.gray, 50))

    color okCol   = color.new(color.green, 80)
    color warnCol = color.new(color.orange, 70)
    color badCol  = color.new(color.red, 70)
    color headCol = color.new(color.gray, 75)
    color offCol  = color.new(color.gray, 85)

    string state = not envOk ? "BLOCKED" : inPos ? "IN TRADE" : pending ? "ORDER WORKING" : not rangeOk ? "NO RANGE" : not inWin ? "WAITING FOR WINDOW" : not tradesOk ? "DONE FOR TODAY" : dir == 0 ? "WAITING FOR SWEEP" : "SWEPT - AWAITING DISPLACEMENT"
    color stateCol = not envOk ? badCol : inPos or pending ? okCol : dir != 0 ? warnCol : offCol

    table.cell(dash, 0, 0, "TP London Session", text_color=color.white, bgcolor=headCol, text_size=size.small)
    table.cell(dash, 1, 0, state, text_color=color.white, bgcolor=stateCol, text_size=size.small)

    string envMsg = not intradayOk ? "Needs 15m or lower" : not atrOk ? "ATR warming up" : "OK"
    table.cell(dash, 0, 1, "Chart", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 1, envMsg, text_color=envOk ? color.lime : color.red, text_size=size.tiny)

    table.cell(dash, 0, 2, "Window", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2, winSess + "  " + str.replace_all(tzName, "America/", ""), text_color=inWin ? color.lime : color.silver, text_size=size.tiny)

    table.cell(dash, 0, 3, "Range", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, rangeOk ? str.tostring(rngLo, format.mintick) + " - " + str.tostring(rngHi, format.mintick) : "n/a", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 4, "Range size (pts)", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, rangeOk ? str.tostring((rngHi - rngLo) / syminfo.mintick, "#") : "n/a", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 5, "Sweep", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, dir == 0 ? "none" : (dir == -1 ? "buy side -> short" : "sell side -> long") + (na(sweepBar) ? "" : "  (" + str.tostring(bar_index - sweepBar) + " bars)"), text_color=dir == 0 ? color.silver : color.orange, text_size=size.tiny)

    table.cell(dash, 0, 6, "Sweep extreme", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 6, na(sweepExt) ? "n/a" : str.tostring(sweepExt, format.mintick), text_color=color.white, text_size=size.tiny)

    string dispMsg = dir == 0 ? "n/a" : (bearSetup ? (upCnt >= minRun ? str.tostring(upCnt) + " up candles" : "run too short") : (dnCnt >= minRun ? str.tostring(dnCnt) + " down candles" : "run too short")) + (bigBody ? " / body ok" : " / body small")
    table.cell(dash, 0, 7, "Displacement", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 7, dispMsg, text_color=dispShort or dispLong ? color.lime : color.silver, text_size=size.tiny)

    table.cell(dash, 0, 8, "New range 50%", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 8, dir == 0 ? "n/a" : str.tostring(eqPx, format.mintick), text_color=color.orange, text_size=size.tiny)

    string smtMsg = not smtOn ? "off" : (smtOk ? "diverging" : "confirming - blocked")
    table.cell(dash, 0, 9, "SMT", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 9, smtMsg, text_color=not smtOn ? color.silver : smtOk ? color.lime : color.orange, text_size=size.tiny)

    string gateMsg = dir == 0 ? "waiting" : not rrOk ? "RR too low" : not premOk ? "not in premium/discount" : not gapOk ? "no FVG" : not zoneOk ? "limit through market" : not tradesOk ? "max trades" : "clear"
    table.cell(dash, 0, 10, "Gates", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 10, gateMsg, text_color=gateMsg == "clear" ? color.lime : gateMsg == "waiting" ? color.silver : color.orange, text_size=size.tiny)

    table.cell(dash, 0, 11, "Live setup RR", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 11, dir == 0 or na(setupRR) ? "n/a" : str.tostring(setupRR, "#.##") + "  (need " + str.tostring(minRR, "#.##") + ")", text_color=rrOk ? color.lime : color.orange, text_size=size.tiny)

    table.cell(dash, 0, 12, "Last E / SL / TP", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 12, na(lastEntry) ? "none yet" : str.tostring(lastEntry, format.mintick) + " / " + str.tostring(lastStop, format.mintick) + " / " + str.tostring(lastTgt, format.mintick) + "  @" + str.tostring(lastRR, "#.##") + "R", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 13, "Last qty", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 13, na(lastQty) ? "none yet" : str.tostring(lastQty, "#.##") + (lastCap ? "  (capped)" : ""), text_color=lastCap ? color.orange : color.white, text_size=size.tiny)

    // A leg stuck at zero is the failure mode that reads as a bad strategy: it
    // means one direction's condition is contradicting itself and half the model
    // has never run. The Strategy Tester cannot show you this.
    table.cell(dash, 0, 14, "Taken S / L", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 14, str.tostring(shortTaken) + " / " + str.tostring(longTaken) + "   today " + str.tostring(dayTrades) + "/" + str.tostring(maxTrades), text_color=shortTaken == 0 or longTaken == 0 ? color.orange : color.white, text_size=size.tiny)

    // The funnel. Read it left to right and stop at the first big drop — that is the
    // stage rejecting your setups, and it is the only one worth changing a setting for.
    string funnel = str.tostring(dWindows) + " > " + str.tostring(dSwept) + " > " + str.tostring(dDisplaced) + " > " + str.tostring(dTraded)
    color funCol = dWindows == 0 ? color.silver : dSwept * 2 < dWindows ? color.orange : color.white
    table.cell(dash, 0, 15, "Days W>S>D>T", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 15, funnel, text_color=funCol, text_size=size.tiny)

    float beWin = na(minRR) or minRR <= 0 ? na : 100.0 / (1.0 + minRR)
    table.cell(dash, 0, 16, "Time/Flat/Unfilled", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 16, str.tostring(exTime) + " / " + str.tostring(exFlat) + " / " + str.tostring(exExpired) + "   BE win " + str.tostring(beWin, "#.#") + "%", text_color=color.white, text_size=size.tiny)
