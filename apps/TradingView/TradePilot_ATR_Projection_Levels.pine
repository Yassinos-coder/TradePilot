//@version=6
// ============================================================================
// TradePilot ATR Projection Levels — Weekly Volatility Map
// ----------------------------------------------------------------------------
// Indicator version of Yassine's manual volatility-projection workflow:
//   1. Anchor from the last confirmed weekly close.
//   2. Project weekly ATR units in the active bias direction.
//   3. Draw Fibonacci-style expansion notches: -2, -1.5, -1, 0, 1, 1.5, 2.
//   4. Convert each notch into a horizontal reaction zone whose height is the
//      equilibrium of 4H ATR values from the last completed weekly window.
//
// Also provides chart-timeframe moving averages where EACH of the 5 lines has
// its own selectable type — EMA / SMA / SMMA (RMA) / WMA / VWMA — a proximity
// readout, an optional bias tint for reviewing the structure filter
// historically, and alerts on zone entry and bias flips.
// ============================================================================

indicator("TradePilot ATR Projection Levels", "TP ATR Levels", overlay=true, max_lines_count=200, max_boxes_count=100, max_labels_count=200)

// ============================================================================
// INPUTS
// ============================================================================
grpBias   = "Trend Detection"
grpAtr    = "ATR Projection"
grpMa     = "Moving Averages"
grpStyle  = "Style"
grpDash   = "Dashboard"

trendMode = input.string("Auto", "Trend Detection", options=["Auto", "Manual"], group=grpBias)
manualDir = input.string("Bullish", "Manual Direction", options=["Bullish", "Bearish"], group=grpBias, tooltip="Used only when Trend Detection = Manual.")

atrLen = input.int(14, "ATR Length", minval=1, group=grpAtr)
includeHalfNotches = input.bool(false, "Include Half Notches (+/- 0.5)", group=grpAtr, tooltip="Adds -0.5 and +0.5 to the projection ladder, i.e. half-weekly-ATR steps between the whole notches. Off keeps the original -2, -1.5, -1, 0, 1, 1.5, 2 set.")
showWeeklyZones = input.bool(true, "Show Weekly ATR Zones", group=grpAtr)
showWeeklyMidlines = input.bool(true, "Show Weekly Zone Midlines", group=grpAtr)
zoneAtrSource = input.string("4H ATR Equilibrium", "Zone Height", options=["4H ATR Equilibrium", "Weekly ATR"], group=grpAtr, tooltip="4H ATR Equilibrium = midpoint between 4H ATR high/low from the last closed week.")

maSource = input.source(close, "Source", group=grpMa)
maWidth = input.int(1, "Line Width", minval=1, maxval=4, group=grpMa)
showEma1 = input.bool(true, "MA 1", inline="ema1", group=grpMa)
lenEma1 = input.int(9, "", minval=1, inline="ema1", group=grpMa)
typeEma1 = input.string("EMA", "", options=["EMA", "SMA", "SMMA (RMA)", "WMA", "VWMA"], inline="ema1", group=grpMa)
colEma1 = input.color(#EF5350, "", inline="ema1", group=grpMa)
showEma2 = input.bool(true, "MA 2", inline="ema2", group=grpMa)
lenEma2 = input.int(21, "", minval=1, inline="ema2", group=grpMa)
typeEma2 = input.string("EMA", "", options=["EMA", "SMA", "SMMA (RMA)", "WMA", "VWMA"], inline="ema2", group=grpMa)
colEma2 = input.color(#FFA726, "", inline="ema2", group=grpMa)
showEma3 = input.bool(true, "MA 3", inline="ema3", group=grpMa)
lenEma3 = input.int(50, "", minval=1, inline="ema3", group=grpMa)
typeEma3 = input.string("EMA", "", options=["EMA", "SMA", "SMMA (RMA)", "WMA", "VWMA"], inline="ema3", group=grpMa)
colEma3 = input.color(#26A69A, "", inline="ema3", group=grpMa)
showEma4 = input.bool(true, "MA 4", inline="ema4", group=grpMa)
lenEma4 = input.int(100, "", minval=1, inline="ema4", group=grpMa)
typeEma4 = input.string("EMA", "", options=["EMA", "SMA", "SMMA (RMA)", "WMA", "VWMA"], inline="ema4", group=grpMa)
colEma4 = input.color(#42A5F5, "", inline="ema4", group=grpMa)
showEma5 = input.bool(true, "MA 5", inline="ema5", group=grpMa)
lenEma5 = input.int(200, "", minval=1, inline="ema5", group=grpMa)
typeEma5 = input.string("EMA", "", options=["EMA", "SMA", "SMMA (RMA)", "WMA", "VWMA"], inline="ema5", group=grpMa)
colEma5 = input.color(#AB47BC, "", inline="ema5", group=grpMa)

extendBarsLeft = input.int(250, "Extend Left Bars", minval=10, group=grpStyle)
extendBarsRight = input.int(250, "Extend Right Bars", minval=10, group=grpStyle)
zoneBg = input.color(color.new(color.gray, 84), "Weekly Zone Background", group=grpStyle)
zoneBorder = input.color(color.new(color.gray, 55), "Weekly Zone Border", group=grpStyle)
weeklyMidColor = input.color(color.new(color.black, 0), "Weekly Midline", group=grpStyle)
labelColor = input.color(color.new(color.black, 0), "Label Text", group=grpStyle)
showPriceLabels = input.bool(true, "Show Price Labels", group=grpStyle)
limitZones = input.bool(false, "Only Show Zones Near Price", group=grpStyle, tooltip="Hides projection zones farther from price than the distance below, measured in Weekly ATR units.")
zoneRadiusAtr = input.float(2.0, "Max Zone Distance (Weekly ATR)", minval=0.5, step=0.5, group=grpStyle)
showBiasBg = input.bool(false, "Tint Background By Bias", group=grpStyle, tooltip="Colors every historical bar by the detected weekly bias, so the structure filter can be reviewed by scrolling back.")
bullBg = input.color(color.new(color.green, 92), "Tint  Bull", inline="biasbg", group=grpStyle)
bearBg = input.color(color.new(color.red, 92), "Bear", inline="biasbg", group=grpStyle)
rangeBg = input.color(color.new(color.yellow, 93), "Range", inline="biasbg", group=grpStyle)

showDashboard = input.bool(true, "Show Status Watermark", group=grpDash)
showMATrendWatermark = input.bool(true, "Show MTF MA Trend Watermark", group=grpDash)
maTrendWatermarkCorner = input.string("Top Left", "MTF MA Trend Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=grpDash, tooltip="Top Right shares the Status Watermark corner. Hide one watermark to avoid overlap when using that position.")

maTrendWatermarkPosition = switch maTrendWatermarkCorner
    "Top Right" => position.top_right
    "Bottom Left" => position.bottom_left
    "Bottom Right" => position.bottom_right
    => position.top_left

// ============================================================================
// MOVING AVERAGES — each line independently typed
// ============================================================================
f_ma(src, len, maType) =>
    switch maType
        "SMA" => ta.sma(src, len)
        "SMMA (RMA)" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        => ta.ema(src, len)

ema1 = f_ma(maSource, lenEma1, typeEma1)
ema2 = f_ma(maSource, lenEma2, typeEma2)
ema3 = f_ma(maSource, lenEma3, typeEma3)
ema4 = f_ma(maSource, lenEma4, typeEma4)
ema5 = f_ma(maSource, lenEma5, typeEma5)

plot(showEma1 ? ema1 : na, "MA 1", color=colEma1, linewidth=maWidth)
plot(showEma2 ? ema2 : na, "MA 2", color=colEma2, linewidth=maWidth)
plot(showEma3 ? ema3 : na, "MA 3", color=colEma3, linewidth=maWidth)
plot(showEma4 ? ema4 : na, "MA 4", color=colEma4, linewidth=maWidth)
plot(showEma5 ? ema5 : na, "MA 5", color=colEma5, linewidth=maWidth)

// ============================================================================
// MULTI-TIMEFRAME MA TREND
// ----------------------------------------------------------------------------
// This function is evaluated inside each request.security() context so both
// price and every configured MA are calculated directly from that timeframe's
// bars. A tied vote (including no enabled MAs) is neutral/ranging.
// ============================================================================
f_maTrend() =>
    trendMa1 = f_ma(maSource, lenEma1, typeEma1)
    trendMa2 = f_ma(maSource, lenEma2, typeEma2)
    trendMa3 = f_ma(maSource, lenEma3, typeEma3)
    trendMa4 = f_ma(maSource, lenEma4, typeEma4)
    trendMa5 = f_ma(maSource, lenEma5, typeEma5)

    int score = 0
    score += showEma1 ? (not na(trendMa1) and close > trendMa1 ? 1 : -1) : 0
    score += showEma2 ? (not na(trendMa2) and close > trendMa2 ? 1 : -1) : 0
    score += showEma3 ? (not na(trendMa3) and close > trendMa3 ? 1 : -1) : 0
    score += showEma4 ? (not na(trendMa4) and close > trendMa4 ? 1 : -1) : 0
    score += showEma5 ? (not na(trendMa5) and close > trendMa5 ? 1 : -1) : 0
    score > 0 ? 1 : score < 0 ? -1 : 0

f_trendText(trend) =>
    trend == 1 ? "BULLISH" : trend == -1 ? "BEARISH" : "RANGING"

f_trendColor(trend) =>
    trend == 1 ? color.lime : trend == -1 ? color.red : color.yellow

trend1H = request.security(syminfo.tickerid, "60", f_maTrend(), lookahead=barmerge.lookahead_off)
trend4H = request.security(syminfo.tickerid, "240", f_maTrend(), lookahead=barmerge.lookahead_off)
trendD = request.security(syminfo.tickerid, "D", f_maTrend(), lookahead=barmerge.lookahead_off)
trendW = request.security(syminfo.tickerid, "W", f_maTrend(), lookahead=barmerge.lookahead_off)

// ============================================================================
// HIGHER TIMEFRAME DATA — the last COMPLETED weekly bar.
// ----------------------------------------------------------------------------
// "Last confirmed weekly close" has to mean the close of the most recently
// FINISHED week. Reading close[1] off the weekly series only says that while the
// current weekly bar is still forming: the moment a week completes — Friday's
// close, and all weekend after it — that finished week IS the anchor, yet close[1]
// still points one week further back. That was the stale anchor (4018.22 on a
// 256.08 ATR instead of 4052.79 on 250.88).
//
// So fetch both offsets and pick with weekDone, true only on the chart bar that
// ends the weekly bar. On that bar the weekly close equals this bar's own close,
// so using it looks ahead at nothing; mid-week we fall back to the previous week.
// The anchor therefore locks in at Friday's close and carries unchanged through
// the following week, which is what the manual workflow does.
//
// lookahead_on is required here, not a shortcut: it makes the weekly bar that
// CONTAINS this chart bar the reference point, identically on history and in
// realtime, so weekDone can then choose the offset. Everything below reads
// values already printed at the time of the bar.
// ============================================================================
[wkTimeClose, wkClose0, wkClose1, wkAtr0, wkAtr1] = request.security(syminfo.tickerid, "W", [time_close, close, close[1], ta.atr(atrLen), ta.atr(atrLen)[1]], lookahead=barmerge.lookahead_on)
[wkMaTrend0, wkMaTrend1, wkHigh1, wkHigh2, wkLow1, wkLow2] = request.security(syminfo.tickerid, "W", [f_maTrend(), f_maTrend()[1], ta.highest(high, 3)[1], ta.highest(high, 3)[2], ta.lowest(low, 3)[1], ta.lowest(low, 3)[2]], lookahead=barmerge.lookahead_on)

weekDone = not na(wkTimeClose) and time_close >= wkTimeClose

weeklyClose = weekDone ? wkClose0 : wkClose1
weeklyAtr   = weekDone ? wkAtr0   : wkAtr1
weeklyMaTrend = weekDone ? wkMaTrend0 : wkMaTrend1
weeklyStructHigh = weekDone ? wkHigh1 : wkHigh2
weeklyStructLow  = weekDone ? wkLow1  : wkLow2

// 4H ATR equilibrium from the last completed weekly window. This mirrors the
// manual step of dropping to H4, finding ATR high/low between weekly boundaries,
// and using the midpoint as the zone height.
h4Atr = request.security(syminfo.tickerid, "240", ta.atr(atrLen)[1], lookahead=barmerge.lookahead_on)
isNewWeek = timeframe.change("W")
var float curWeekH4AtrHigh = na
var float curWeekH4AtrLow = na
var float prevWeekH4AtrHigh = na
var float prevWeekH4AtrLow = na

if isNewWeek
    prevWeekH4AtrHigh := curWeekH4AtrHigh
    prevWeekH4AtrLow := curWeekH4AtrLow
    curWeekH4AtrHigh := h4Atr
    curWeekH4AtrLow := h4Atr
else
    curWeekH4AtrHigh := na(curWeekH4AtrHigh) ? h4Atr : math.max(curWeekH4AtrHigh, h4Atr)
    curWeekH4AtrLow := na(curWeekH4AtrLow) ? h4Atr : math.min(curWeekH4AtrLow, h4Atr)

// The intra-week ATR high/low is sampled once per CHART bar, so the equilibrium is
// only meaningful when the chart timeframe is 4H or lower. Above that there are too
// few samples per week, and the value silently degrades — fall back to Weekly ATR.
h4EqReliable = timeframe.in_seconds() <= 14400
// Same weekDone rule as the anchor: once a week has finished, ITS 4H window is
// the completed one. Mid-week, the previous week's window is.
h4AtrEqCur  = (not na(curWeekH4AtrHigh)  and not na(curWeekH4AtrLow))  ? (curWeekH4AtrHigh  + curWeekH4AtrLow)  / 2.0 : na
h4AtrEqPrev = (not na(prevWeekH4AtrHigh) and not na(prevWeekH4AtrLow)) ? (prevWeekH4AtrHigh + prevWeekH4AtrLow) / 2.0 : na
h4AtrEq = weekDone ? h4AtrEqCur : h4AtrEqPrev
h4EqUsable = h4EqReliable and not na(h4AtrEq)
useH4Eq = zoneAtrSource == "4H ATR Equilibrium" and h4EqUsable
zoneHeight = useH4Eq ? h4AtrEq : weeklyAtr

// ============================================================================
// BIAS / MARKET STRUCTURE
// ============================================================================
autoBull = weeklyMaTrend == 1 and weeklyClose > weeklyStructHigh
autoBear = weeklyMaTrend == -1 and weeklyClose < weeklyStructLow

int direction = 0
if trendMode == "Manual"
    direction := manualDir == "Bullish" ? 1 : -1
else
    direction := autoBull ? 1 : autoBear ? -1 : 0

statusText = direction == 1 ? "Bullish" : direction == -1 ? "Bearish" : "Ranging — no levels"
canDraw = direction != 0 and not na(weeklyClose) and not na(weeklyAtr) and weeklyAtr > 0 and not na(zoneHeight) and zoneHeight > 0

bgcolor(showBiasBg ? (direction == 1 ? bullBg : direction == -1 ? bearBg : rangeBg) : na, title="Bias Tint")

// ============================================================================
// DRAW HELPERS
// ============================================================================
var float[] fibs = includeHalfNotches ? array.from(-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0) : array.from(-2.0, -1.5, -1.0, 0.0, 1.0, 1.5, 2.0)
var box[] weeklyBoxes = array.new_box()
var line[] weeklyLines = array.new_line()
var label[] weeklyLabels = array.new_label()

clearDrawings() =>
    while array.size(weeklyBoxes) > 0
        box.delete(array.pop(weeklyBoxes))
    while array.size(weeklyLines) > 0
        line.delete(array.pop(weeklyLines))
    while array.size(weeklyLabels) > 0
        label.delete(array.pop(weeklyLabels))

projectLevel(anchor, unit, fib, dir) =>
    anchor + unit * fib * dir

fmtFib(fib) =>
    fib > 0 ? "+" + str.tostring(fib, "#.##") : str.tostring(fib, "#.##")

fmtLevel(prefix, fib, price) =>
    prefix + " " + str.tostring(fib, "#.##") + "  " + str.tostring(math.round_to_mintick(price))

// ============================================================================
// LEVEL SCAN
// ----------------------------------------------------------------------------
// Runs on every bar (not just the last one) so alerts fire historically and the
// dashboard proximity readout stays live.
// ============================================================================
bool insideZone = false
float insideFib = na
float insideBestDist = na
float nearestFib = na
float nearestMid = na
float nearestDist = na

if canDraw
    halfZone = zoneHeight / 2.0
    for i = 0 to array.size(fibs) - 1
        fib = array.get(fibs, i)
        mid = projectLevel(weeklyClose, weeklyAtr, fib, direction)
        dist = math.abs(close - mid)

        if na(nearestDist) or dist < nearestDist
            nearestDist := dist
            nearestFib := fib
            nearestMid := mid

        if high >= mid - halfZone and low <= mid + halfZone
            insideZone := true
            if na(insideBestDist) or dist < insideBestDist
                insideBestDist := dist
                insideFib := fib

// ============================================================================
// ALERTS
// ============================================================================
zoneEntry = insideZone and not insideZone[1]
flipBull = direction == 1 and direction[1] != 1
flipBear = direction == -1 and direction[1] != -1

alertcondition(zoneEntry, "Price entered an ATR zone", "TradePilot: price entered an ATR projection zone")
alertcondition(flipBull, "Weekly bias flipped bullish", "TradePilot: weekly bias flipped bullish — ATR levels rebuilt upward")
alertcondition(flipBear, "Weekly bias flipped bearish", "TradePilot: weekly bias flipped bearish — ATR levels rebuilt downward")

// Redraw only on the last chart bar to keep object count stable.
if barstate.islast
    clearDrawings()

    if canDraw
        leftX = bar_index - extendBarsLeft
        rightX = bar_index + extendBarsRight

        if showWeeklyZones
            for i = 0 to array.size(fibs) - 1
                fib = array.get(fibs, i)
                mid = projectLevel(weeklyClose, weeklyAtr, fib, direction)
                withinRadius = not limitZones or math.abs(close - mid) <= zoneRadiusAtr * weeklyAtr

                if withinRadius
                    top = mid + zoneHeight / 2.0
                    bottom = mid - zoneHeight / 2.0
                    bx = box.new(leftX, top, rightX, bottom, xloc=xloc.bar_index, bgcolor=zoneBg, border_color=zoneBorder)
                    array.push(weeklyBoxes, bx)

                    if showWeeklyMidlines
                        ln = line.new(leftX, mid, rightX, mid, xloc=xloc.bar_index, color=weeklyMidColor, width=1)
                        array.push(weeklyLines, ln)

                    if showPriceLabels
                        lb = label.new(rightX, mid, fmtLevel("W", fib, mid), xloc=xloc.bar_index, style=label.style_label_left, textcolor=labelColor, color=color.new(color.white, 100), size=size.small)
                        array.push(weeklyLabels, lb)

// ============================================================================
// STATUS WATERMARK / DASHBOARD
// ============================================================================
h4EqText = not h4EqReliable ? "n/a above 4H chart" : na(h4AtrEq) ? "warming up" : str.tostring(math.round_to_mintick(h4AtrEq))
h4EqColor = (zoneAtrSource == "4H ATR Equilibrium" and not h4EqUsable) ? color.orange : color.white
zoneHeightText = (useH4Eq ? "4H ATR Eq" : "Weekly ATR") + (na(zoneHeight) ? "" : "  " + str.tostring(math.round_to_mintick(zoneHeight)))
nearestText = na(nearestMid) ? "-" : fmtFib(nearestFib) + "  " + str.tostring(math.round_to_mintick(nearestMid))
distText = na(nearestDist) ? "-" : str.tostring(math.round_to_mintick(nearestDist)) + "  (" + str.tostring(math.round(nearestDist / weeklyAtr * 100)) + "% W-ATR)"
inZoneText = insideZone ? fmtFib(insideFib) : "no"

var table dash = na
if showDashboard and barstate.islast
    if not na(dash)
        table.delete(dash)
    dash := table.new(position.top_right, 2, 10, frame_color=color.new(color.gray, 70), border_width=1, bgcolor=color.new(color.black, 82))
    table.cell(dash, 0, 0, "TradePilot ATR Levels", text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)
    table.cell(dash, 0, 1, "Mode", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1, trendMode, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "Structure", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 2, statusText, text_color=direction == 1 ? color.lime : direction == -1 ? color.red : color.yellow, text_size=size.small)
    table.cell(dash, 0, 3, "Anchor", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3, na(weeklyClose) ? "-" : str.tostring(math.round_to_mintick(weeklyClose)), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "Weekly ATR", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 4, na(weeklyAtr) ? "-" : str.tostring(math.round_to_mintick(weeklyAtr)), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 5, "Zone Height", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 5, zoneHeightText, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 6, "4H ATR Eq", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 6, h4EqText, text_color=h4EqColor, text_size=size.small)
    table.cell(dash, 0, 7, "Nearest Zone", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7, nearestText, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 8, "Distance", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 8, distText, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 9, "In Zone", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 9, inZoneText, text_color=insideZone ? color.aqua : color.gray, text_size=size.small)

// ============================================================================
// MULTI-TIMEFRAME MA TREND WATERMARK
// ============================================================================
var table maTrendWatermark = na
if barstate.islast
    if showMATrendWatermark
        if na(maTrendWatermark)
            maTrendWatermark := table.new(maTrendWatermarkPosition, 2, 5, frame_color=color.new(color.gray, 65), frame_width=1, border_color=color.new(color.gray, 80), border_width=1, bgcolor=color.new(color.black, 12))

        table.cell(maTrendWatermark, 0, 0, "MA TREND", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.black, 5))
        table.cell(maTrendWatermark, 1, 0, syminfo.ticker, text_color=color.white, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(color.black, 5))
        table.cell(maTrendWatermark, 0, 1, "1H", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
        table.cell(maTrendWatermark, 1, 1, f_trendText(trend1H), text_color=f_trendColor(trend1H), text_size=size.small, text_halign=text.align_right)
        table.cell(maTrendWatermark, 0, 2, "4H", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
        table.cell(maTrendWatermark, 1, 2, f_trendText(trend4H), text_color=f_trendColor(trend4H), text_size=size.small, text_halign=text.align_right)
        table.cell(maTrendWatermark, 0, 3, "D", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
        table.cell(maTrendWatermark, 1, 3, f_trendText(trendD), text_color=f_trendColor(trendD), text_size=size.small, text_halign=text.align_right)
        table.cell(maTrendWatermark, 0, 4, "W", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
        table.cell(maTrendWatermark, 1, 4, f_trendText(trendW), text_color=f_trendColor(trendW), text_size=size.small, text_halign=text.align_right)
    else if not na(maTrendWatermark)
        table.delete(maTrendWatermark)
        maTrendWatermark := na

var label rangeWatermark = na
if barstate.islast
    if not na(rangeWatermark)
        label.delete(rangeWatermark)
        rangeWatermark := na
    if showDashboard and direction == 0
        rangeWatermark := label.new(bar_index, high, "RANGING — ATR projection levels hidden", xloc=xloc.bar_index, style=label.style_label_down, textcolor=color.black, color=color.new(color.yellow, 15), size=size.normal)
// ============================================================================
