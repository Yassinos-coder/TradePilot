//@version=6
// ============================================================================
// TradePilot ORB — Opening Range Breakout Strategy
// ----------------------------------------------------------------------------
// Port of the MT5 EA  apps/Metatrader-eas/MT5/TradePilot_ORB_EA.mq5
//
// Strategy (New York session):
//   1. Mark the opening range High/Low (wicks included) formed by the first
//      N minutes after 09:30 New York.
//   2. On the chart (confirmation) timeframe, wait for a candle to CLOSE
//      outside the range:  close > rangeHigh -> BUY,  close < rangeLow -> SELL.
//   3. One breakout per direction per day, one position at a time, no re-entry
//      until the next NY day.
//   4. ATR stop-loss, Risk:Reward take-profit, fixed or risk-% sizing.
//
// Differences vs the MT5 EA (platform constraints, not logic changes):
//   * Single-symbol — a TradingView strategy trades ONLY the chart symbol.
//     Apply it to each symbol's chart separately (XAUUSD, US100, US30, ...).
//   * New York time / DST is handled natively via the timezone input — no
//     manual broker GMT offset needed.
//   * Confirmation timeframe = the CHART timeframe. Run on a 1–5 min chart to
//     mirror the M1/M2/M5 confirmation of the EA.
//   * Spread filter omitted — TradingView backtests expose no reliable spread.
//   * "Lot" becomes strategy "qty" (contracts/units).
//
// Recommended: 1-minute or 5-minute chart, "process orders on close" (set).
// ============================================================================

strategy("TradePilot ORB Breakout", "ORB",
     overlay                 = true,
     pyramiding              = 0,
     initial_capital         = 10000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.0,
     slippage                = 0,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     max_boxes_count         = 200,
     max_lines_count         = 200,
     max_labels_count        = 200)

// ============================================================================
// INPUT GROUPS
// ============================================================================
grpSession  = "New York Session"
grpStop     = "Stop Loss (ATR)"
grpTp       = "Take Profit"
grpSizing   = "Position Sizing"
grpSchedule = "Trading Schedule"
grpViz      = "Visuals"
grpDash     = "Dashboard"

// ============================================================================
// INPUTS
// ============================================================================
// Session
tz        = input.string("America/New_York", "Session Timezone", group=grpSession, tooltip="DST handled automatically for this zone.")
sHour     = input.int(9,  "Session Start Hour (NY)",   0, 23, group=grpSession)
sMin      = input.int(30, "Session Start Minute (NY)", 0, 59, group=grpSession)
orMins    = input.int(15, "Opening Range Minutes",     1,     group=grpSession)
eHour     = input.int(12, "Entry Window End Hour (NY)", 0, 23, group=grpSession)
eMin      = input.int(0,  "Entry Window End Minute (NY)", 0, 59, group=grpSession)

// Stop Loss (ATR)
atrPeriod = input.int(14, "ATR Period", 1, group=grpStop)
atrTf     = input.timeframe("15", "ATR Timeframe", group=grpStop)
atrMult   = input.float(1.5, "ATR Multiplier", minval=0.1, step=0.1, group=grpStop)

// Take Profit
rr        = input.float(2.0, "Risk : Reward Ratio", minval=0.1, step=0.1, group=grpTp)

// Position Sizing
sizeMode  = input.string("Risk %", "Sizing Mode", options=["Risk %", "Fixed Qty"], group=grpSizing)
fixedQty  = input.float(0.10, "Fixed Qty (contracts/lots)", minval=0.0, step=0.01, group=grpSizing)
riskPct   = input.float(1.0,  "Risk % of Equity", minval=0.0, step=0.1, group=grpSizing)

// Trading Schedule
tMon = input.bool(true, "Monday",    group=grpSchedule)
tTue = input.bool(true, "Tuesday",   group=grpSchedule)
tWed = input.bool(true, "Wednesday", group=grpSchedule)
tThu = input.bool(true, "Thursday",  group=grpSchedule)
tFri = input.bool(true, "Friday",    group=grpSchedule)
oneTradePerDay = input.bool(true, "One Trade Per Day", group=grpSchedule, tooltip="Matches the MT5 EA default: once any breakout trade is taken, ignore opposite breakouts until the next NY day.")

// Visuals
showRange  = input.bool(true, "Show Opening Range", group=grpViz)
showLevels = input.bool(true, "Show Trade Levels",  group=grpViz)
rangeCol   = input.color(color.new(color.blue,  85), "Range Fill",  group=grpViz)
hiCol      = input.color(color.new(color.green, 0),  "Range High",  group=grpViz)
loCol      = input.color(color.new(color.red,   0),  "Range Low",   group=grpViz)

// Dashboard
showDash = input.bool(true, "Show Dashboard", group=grpDash)
dashPos  = input.string("Top Right", "Dashboard Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grpDash)

// ============================================================================
// TIME (New York) — native timezone handling replaces the EA's DST math.
// ============================================================================
nyH = hour(time, tz)
nyM = minute(time, tz)
tod = nyH * 60 + nyM                 // NY minutes-since-midnight

sessStart = sHour * 60 + sMin
orEnd     = sessStart + orMins
entryEnd  = eHour * 60 + eMin

dayKey   = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
isNewDay = na(dayKey[1]) or dayKey != dayKey[1]

dow          = dayofweek(time, tz)
isTradingDay = (dow == dayofweek.monday    and tMon) or
               (dow == dayofweek.tuesday   and tTue) or
               (dow == dayofweek.wednesday and tWed) or
               (dow == dayofweek.thursday  and tThu) or
               (dow == dayofweek.friday    and tFri)

// ============================================================================
// ATR (higher timeframe) — non-repainting via lookahead_off.
// ============================================================================
htfAtr = request.security(syminfo.tickerid, atrTf, ta.atr(atrPeriod), lookahead = barmerge.lookahead_off)

// ============================================================================
// DAILY STATE MACHINE  (mirrors CSymbolTrader in the EA)
// ============================================================================
var float rHigh       = na
var float rLow        = na
var bool  rReady      = false
var bool  tradedToday = false
var bool  boughtToday = false
var bool  soldToday   = false
var int   orStartBar  = na

// Performance / trade tracking
var int   longCount = 0
var int   shortCount = 0
var float lastEn = na
var float lastSl = na
var float lastTp = na
var int   lastDir = 0

// 1) New NY day -> reset all daily state.
if isNewDay
    rHigh       := na
    rLow        := na
    rReady      := false
    tradedToday := false
    boughtToday := false
    soldToday   := false
    orStartBar  := na

// 2) Accumulate the opening range over [sessionStart, sessionStart+orMins).
inOr = tod >= sessStart and tod < orEnd
if inOr
    if na(orStartBar)
        orStartBar := bar_index
    rHigh := na(rHigh) ? high : math.max(rHigh, high)
    rLow  := na(rLow)  ? low  : math.min(rLow,  low)

// 3) Lock the range once its window has closed.
justLocked = false
if (not rReady) and tod >= orEnd and not na(rHigh) and not na(rLow) and rHigh > rLow
    rReady     := true
    justLocked := true

// ============================================================================
// BREAKOUT CONFIRMATION + FILTERS
// ============================================================================
withinEntry = rReady and tod <= entryEnd
dayTradeOk  = not oneTradePerDay or not tradedToday
longSig     = withinEntry and dayTradeOk and not boughtToday and close > rHigh
shortSig    = withinEntry and dayTradeOk and not soldToday   and close < rLow

flat     = strategy.position_size == 0
canTrade = barstate.isconfirmed and flat and isTradingDay and not na(htfAtr) and htfAtr > 0

// ============================================================================
// POSITION SIZING  (mirrors CTradeMath::LotForRisk)
// ============================================================================
f_qty(slDist) =>
    q = 0.0
    if sizeMode == "Fixed Qty"
        q := fixedQty
    else if slDist > 0
        riskCash = strategy.equity * riskPct / 100.0
        perUnit  = slDist * syminfo.pointvalue
        q := perUnit > 0 ? riskCash / perUnit : 0.0
    q

// ============================================================================
// ENTRIES / EXITS
// ============================================================================
var line enLn = na
var line slLn = na
var line tpLn = na

tookLong  = false
tookShort = false

if canTrade and longSig
    slDist = htfAtr * atrMult
    en = close
    sl = en - slDist
    tp = en + slDist * rr
    q  = f_qty(slDist)
    if q > 0 and sl < en
        strategy.entry("Long", strategy.long, qty = q)
        strategy.exit("Long TP/SL", from_entry = "Long", stop = sl, limit = tp)
        tradedToday := true
        boughtToday := true
        longCount   += 1
        lastEn := en
        lastSl := sl
        lastTp := tp
        lastDir := 1
        tookLong := true

if canTrade and shortSig
    slDist = htfAtr * atrMult
    en = close
    sl = en + slDist
    tp = en - slDist * rr
    q  = f_qty(slDist)
    if q > 0 and sl > en
        strategy.entry("Short", strategy.short, qty = q)
        strategy.exit("Short TP/SL", from_entry = "Short", stop = sl, limit = tp)
        tradedToday := true
        soldToday  := true
        shortCount += 1
        lastEn := en
        lastSl := sl
        lastTp := tp
        lastDir := -1
        tookShort := true

// Draw entry/SL/TP levels for the current trade (replaces any previous set).
if (tookLong or tookShort) and showLevels
    if not na(enLn)
        line.delete(enLn)
    if not na(slLn)
        line.delete(slLn)
    if not na(tpLn)
        line.delete(tpLn)
    enLn := line.new(bar_index, lastEn, bar_index + 1, lastEn, color=color.white, style=line.style_dashed, extend=extend.right)
    slLn := line.new(bar_index, lastSl, bar_index + 1, lastSl, color=color.red,   style=line.style_dotted, extend=extend.right)
    tpLn := line.new(bar_index, lastTp, bar_index + 1, lastTp, color=color.green, style=line.style_dotted, extend=extend.right)

// ============================================================================
// VISUALS — opening-range box + high/low lines, entry markers
// ============================================================================
var box  orBox = na
var line hiLn  = na
var line loLn  = na

if justLocked and showRange and not na(orStartBar)
    orBox := box.new(orStartBar, rHigh, bar_index, rLow, border_color=color.new(color.blue, 40), bgcolor=rangeCol)
    hiLn  := line.new(orStartBar, rHigh, bar_index, rHigh, color=hiCol, width=1)
    loLn  := line.new(orStartBar, rLow,  bar_index, rLow,  color=loCol, width=1)

// Grow the current day's range drawings through the session.
if rReady and showRange and not justLocked and not na(orBox)
    box.set_right(orBox, bar_index)
    line.set_x2(hiLn, bar_index)
    line.set_x2(loLn, bar_index)

plotshape(tookLong,  title="Buy Breakout",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(tookShort, title="Sell Breakout", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),  size=size.small)

// ============================================================================
// ALERTS — configure once via "Any alert() function call".
// ============================================================================
if justLocked
    alert("ORB: opening range formed", alert.freq_once_per_bar_close)
if tookLong
    alert("ORB: BUY breakout entry", alert.freq_once_per_bar_close)
if tookShort
    alert("ORB: SELL breakout entry", alert.freq_once_per_bar_close)
if strategy.position_size == 0 and strategy.position_size[1] != 0
    alert("ORB: position closed (TP or SL)", alert.freq_once_per_bar_close)

// ============================================================================
// DASHBOARD
// ============================================================================
f_pos() =>
    dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left

f_state() =>
    s = "Idle"
    if not isTradingDay
        s := "Off day"
    else if inOr
        s := "Building range"
    else if not rReady and tod < sessStart
        s := "Pre-session"
    else if rReady and tod <= entryEnd
        s := "Armed"
    else if rReady and tod > entryEnd
        s := "Window closed"
    s

var table dash = na
if showDash and bar_index == last_bar_index
    if not na(dash)
        table.delete(dash)
    dash := table.new(f_pos(), 2, 10, frame_color=color.new(color.gray, 60), frame_width=1, border_width=1, border_color=color.new(color.gray, 80), bgcolor=color.new(color.black, 80))

    closed = strategy.closedtrades
    winR   = closed > 0 ? strategy.wintrades / closed * 100 : 0.0
    pf     = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0

    table.cell(dash, 0, 0, "TradePilot ORB", text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker,   text_color=color.white, bgcolor=color.new(color.blue, 50), text_size=size.small)

    table.cell(dash, 0, 1, "State",  text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1, f_state(), text_color=rReady ? color.lime : color.gray, text_size=size.small)

    table.cell(dash, 0, 2, "Range Hi", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 2, na(rHigh) ? "-" : str.tostring(math.round_to_mintick(rHigh)), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 3, "Range Lo", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3, na(rLow) ? "-" : str.tostring(math.round_to_mintick(rLow)), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 4, "Today B / S", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 4, (boughtToday ? "x" : "-") + " / " + (soldToday ? "x" : "-"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 5, "Position", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 5, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "flat", text_color=strategy.position_size != 0 ? color.yellow : color.gray, text_size=size.small)

    table.cell(dash, 0, 6, "Win Rate", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(winR, "#.##") + " %", text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 7, "Profit Factor", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(pf, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 8, "Trades (L / S)", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(closed) + " (" + str.tostring(longCount) + " / " + str.tostring(shortCount) + ")", text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 9, "Sizing / RR", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 9, (sizeMode == "Risk %" ? str.tostring(riskPct, "#.##") + "%" : str.tostring(fixedQty)) + " / 1:" + str.tostring(rr, "#.##"), text_color=color.white, text_size=size.small)
// ============================================================================
