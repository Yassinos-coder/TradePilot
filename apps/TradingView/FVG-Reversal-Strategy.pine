// Derivative work — FVG detection logic adapted from LuxAlgo's "FVG Sessions [LuxAlgo]" indicator
// (CC BY-NC-SA 4.0 — https://creativecommons.org/licenses/by-nc-sa/4.0/), extended into a full entry/exit strategy.

//@version=5
// commission_value is percent PER SIDE. 0.01 ≈ 1.2 pips round trip on NZDUSD — set it to match your broker.
strategy("FVG Reversal Strategy", shorttitle = "FVG Reversal", overlay = true,
     pyramiding = 20, initial_capital = 10000, currency = currency.USD,
     commission_type = strategy.commission.percent, commission_value = 0.01,
     process_orders_on_close = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

//-----------------------------------------------------------------------------
//Inputs
//-----------------------------------------------------------------------------{
grpDir = "Direction"
tradeDir = input.string("Both", "Trade Direction", options = ["Both", "Longs Only", "Shorts Only"], group = grpDir)

grpRisk = "Risk Management"
riskPct       = input.float(1.0, "Risk % Per Trade", minval = 0.1, maxval = 100, group = grpRisk)
maxOpenTrades = input.int(3, "Max Concurrent Positions", minval = 1, maxval = 20, group = grpRisk)
tpMode        = input.string("Fib Extension", "Take Profit Mode", options = ["Fixed R:R", "Fib Extension", "Prior Swing Liquidity"], group = grpRisk)
rrMultiple    = input.float(2.0, "Risk:Reward Multiple (also the fallback target)", minval = 0.1, group = grpRisk)
fibRatio      = input.float(1.618, "Fib Extension Ratio", minval = 0.1, step = 0.1, group = grpRisk)
minRr         = input.float(1.5, "Min R:R To Accept (fib / liquidity modes)", minval = 0.1, group = grpRisk)
stopMode      = input.string("Gap Far Edge", "Stop Placement", options = ["Gap Far Edge", "Pattern Extreme"], group = grpRisk)
stopBufAtr    = input.float(0.2, "Stop Buffer (x ATR)", minval = 0, group = grpRisk)
minStopAtr    = input.float(0.75, "Min Stop Distance (x ATR)", minval = 0, group = grpRisk,
     tooltip = "Floors the risk distance. Stops tighter than this let spread/commission dominate the edge.")
maxLeverage   = input.float(3.0, "Max Notional Leverage", minval = 0.1, group = grpRisk,
     tooltip = "Caps position notional at equity x this. Prevents tiny stops producing absurd position sizes.")
feePctSide    = input.float(0.01, "Fee % Per Side (for the stats table only)", minval = 0, step = 0.005, group = grpRisk,
     tooltip = "Keep this equal to commission_value in the strategy() declaration so the cost/risk row is accurate.")

grpEntry = "Entry / Retest"
triggerMode = input.string("Midpoint (CE)", "Retest Trigger Level", options = ["Near Edge", "Midpoint (CE)", "Far Edge"], group = grpEntry)
minGapAtr   = input.float(0.3, "Min Gap Height (x ATR)", minval = 0, group = grpEntry,
     tooltip = "Ignores micro-gaps. These are noise and they dominate trade count on low timeframes.")
fvgMaxAge   = input.int(60, "Max FVG Age In Bars (0 = no limit)", minval = 0, group = grpEntry)
maxTracked  = input.int(50, "Max Unfilled FVGs Tracked", minval = 5, group = grpEntry)
minTfMin    = input.int(240, "Min Chart Timeframe In Minutes (0 = any)", minval = 0, group = grpEntry)

grpTrend = "Trend Filter (Moving Averages)"
emaMode = input.string("Above/Below MA 200", "MA Filter",
     options = ["Off", "Above/Below All 3", "Above/Below EMA 50", "Above/Below MA 200", "EMA Stack Aligned"], group = grpTrend)
maLen   = input.int(200, "Slow MA Length", minval = 2, group = grpTrend)
maType  = input.string("SMA", "Slow MA Type", options = ["SMA", "EMA"], group = grpTrend)

grpRegime = "Regime Filter (ADX) — trade only when a trend is present"
useAdx = input.bool(true, "Require Trending Regime", group = grpRegime)
adxLen = input.int(14, "ADX / DI Length", group = grpRegime)
adxMin = input.float(20, "Minimum ADX", group = grpRegime)

grpMom = "Momentum Filter (RSI Slowdown)"
useRsiFilter  = input.bool(false, "Require RSI Reversal From Extreme", group = grpMom)
rsiLen        = input.int(14, "RSI Length", group = grpMom)
rsiLookback   = input.int(10, "Lookback For RSI Extreme (bars)", group = grpMom)
rsiOversold   = input.float(35, "RSI Oversold Level", group = grpMom)
rsiOverbought = input.float(65, "RSI Overbought Level", group = grpMom)

grpViz = "Display"
showStats   = input.bool(true, "Show Stats Table", group = grpViz)
showLevels  = input.bool(false, "Draw Stop/Target Lines", group = grpViz)
bullCss     = input.color(color.teal, "Bullish FVG", inline = "bull", group = grpViz)
bullAreaCss = input.color(color.new(color.teal, 55), "Area", inline = "bull", group = grpViz)
bearCss     = input.color(color.red, "Bearish FVG", inline = "bear", group = grpViz)
bearAreaCss = input.color(color.new(color.red, 55), "Area", inline = "bear", group = grpViz)

//-----------------------------------------------------------------------------}
//Timeframe guard
//-----------------------------------------------------------------------------{
tfOk = minTfMin == 0 or timeframe.in_seconds(timeframe.period) >= minTfMin * 60

if barstate.islast and not tfOk
    label.new(bar_index, high, "Chart TF below " + str.tostring(minTfMin) + "m — entries disabled",
      style = label.style_label_down, color = color.orange, textcolor = color.white)

//-----------------------------------------------------------------------------}
//Indicators
//-----------------------------------------------------------------------------{
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
maSlow = maType == "SMA" ? ta.sma(close, maLen) : ta.ema(close, maLen)
rsi    = ta.rsi(close, rsiLen)
atr    = ta.atr(14)

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

plot(ema20,  "EMA 20",  color = color.new(color.yellow, 40))
plot(ema50,  "EMA 50",  color = color.new(color.orange, 40))
plot(ema100, "EMA 100", color = color.new(color.purple, 40))
plot(maSlow, "Slow MA", color = color.blue, linewidth = 2)

emaBullOk = switch emaMode
    "Off"                 => true
    "Above/Below All 3"   => close > ema20 and close > ema50 and close > ema100
    "Above/Below EMA 50"  => close > ema50
    "Above/Below MA 200"  => close > maSlow
    => ema20 > ema50 and ema50 > ema100

emaBearOk = switch emaMode
    "Off"                 => true
    "Above/Below All 3"   => close < ema20 and close < ema50 and close < ema100
    "Above/Below EMA 50"  => close < ema50
    "Above/Below MA 200"  => close < maSlow
    => ema20 < ema50 and ema50 < ema100

rsiBullOk = not useRsiFilter or (ta.lowest(rsi, rsiLookback) < rsiOversold and rsi > rsi[1])
rsiBearOk = not useRsiFilter or (ta.highest(rsi, rsiLookback) > rsiOverbought and rsi < rsi[1])

adxOk      = not useAdx or adxVal >= adxMin
dirLongOk  = tradeDir != "Shorts Only"
dirShortOk = tradeDir != "Longs Only"

//-----------------------------------------------------------------------------}
//Prior-session liquidity levels (used when Take Profit Mode = "Prior Swing Liquidity")
//-----------------------------------------------------------------------------{
prevDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_off)
prevDayLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_off)

//-----------------------------------------------------------------------------}
//FVG type & detection
//-----------------------------------------------------------------------------{
//patternStop doubles as fib anchor A (base of the displacement leg); extremeB tracks
//the running swing extreme since formation (point B). Point C is the retest entry price.
type FVG
    float top
    float btm
    float trigger
    float patternStop
    float extremeB
    bool  isbull
    int   createdBar
    box   area
    line  lvl

var array<FVG> activeFvgs = array.new<FVG>()

var int fvgFormed      = 0
var int fvgTapped      = 0
var int fvgEntered     = 0
var int fvgBlocked     = 0
var int   fvgInvalidated = 0
var int   fvgExpired     = 0
var float sumRisk        = 0.0

var float firstClose = na
if na(firstClose)
    firstClose := close

bull_fvg = low > high[2] and close[1] > high[2] and (low - high[2]) >= minGapAtr * atr
bear_fvg = high < low[2] and close[1] < low[2] and (low[2] - high) >= minGapAtr * atr

if bull_fvg
    if array.size(activeFvgs) >= maxTracked
        dropped = array.shift(activeFvgs)
        box.delete(dropped.area)
        line.delete(dropped.lvl)
    t   = low
    b   = high[2]
    avg = math.avg(t, b)
    trig = triggerMode == "Near Edge" ? t : triggerMode == "Midpoint (CE)" ? avg : b
    array.push(activeFvgs, FVG.new(t, b, trig, low[2], high, true, bar_index,
      box.new(bar_index - 2, t, bar_index, b, border_color = bullCss, bgcolor = bullAreaCss),
      line.new(bar_index - 2, avg, bar_index, avg, color = bullCss, style = line.style_dashed)))
    fvgFormed += 1

if bear_fvg
    if array.size(activeFvgs) >= maxTracked
        dropped = array.shift(activeFvgs)
        box.delete(dropped.area)
        line.delete(dropped.lvl)
    t   = low[2]
    b   = high
    avg = math.avg(t, b)
    trig = triggerMode == "Near Edge" ? b : triggerMode == "Midpoint (CE)" ? avg : t
    array.push(activeFvgs, FVG.new(t, b, trig, high[2], low, false, bar_index,
      box.new(bar_index - 2, t, bar_index, b, border_color = bearCss, bgcolor = bearAreaCss),
      line.new(bar_index - 2, avg, bar_index, avg, color = bearCss, style = line.style_dashed)))
    fvgFormed += 1

//-----------------------------------------------------------------------------}
//Manage active FVGs — retest triggers entry, close-through invalidates, stale gaps expire
//The bar_index > createdBar guard is what makes this a retest strategy rather than a
//displacement-breakout strategy: a gap can never be entered on the bar that formed it.
//-----------------------------------------------------------------------------{
if array.size(activeFvgs) > 0
    for i = array.size(activeFvgs) - 1 to 0
        f     = array.get(activeFvgs, i)
        alive = true

        if bar_index > f.createdBar
            //Track fib point B — the swing extreme reached since the gap formed
            f.extremeB := f.isbull ? math.max(f.extremeB, high) : math.min(f.extremeB, low)

            css     = f.isbull ? bullCss : bearCss
            tapped  = f.isbull ? low <= f.trigger : high >= f.trigger
            through = f.isbull ? close < f.btm : close > f.top
            aged    = fvgMaxAge > 0 and (bar_index - f.createdBar) > fvgMaxAge

            if tapped
                fvgTapped += 1

                if through
                    //Price closed clean through the gap — level failed
                    fvgInvalidated += 1
                    f.area.set_bgcolor(color.new(css, 90))
                    f.area.set_border_color(color.new(css, 70))
                else
                    rawStop = f.isbull
                      ? (stopMode == "Gap Far Edge" ? f.btm - stopBufAtr * atr : f.patternStop)
                      : (stopMode == "Gap Far Edge" ? f.top + stopBufAtr * atr : f.patternStop)

                    //Floor the risk distance. A 3-pip stop on a pair with a 1-pip spread hands
                    //~25% of every trade's risk to costs, which no hit rate can overcome.
                    rawDist  = f.isbull ? close - rawStop : rawStop - close
                    riskDist = math.max(rawDist, minStopAtr * atr)
                    stopLvl  = f.isbull ? close - riskDist : close + riskDist

                    dirOk    = f.isbull ? dirLongOk : dirShortOk
                    filtOk   = f.isbull ? (emaBullOk and rsiBullOk) : (emaBearOk and rsiBearOk)

                    canTrade = dirOk and filtOk and adxOk and tfOk and riskDist > 0
                      and strategy.opentrades < maxOpenTrades

                    if canTrade
                        rrTarget = f.isbull ? close + riskDist * rrMultiple : close - riskDist * rrMultiple
                        target   = rrTarget

                        //Trend-based fib extension: C + ratio x (B - A), C being the retest entry
                        if tpMode == "Fib Extension"
                            leg    = f.isbull ? f.extremeB - f.patternStop : f.patternStop - f.extremeB
                            fibTgt = f.isbull ? close + fibRatio * leg : close - fibRatio * leg
                            fibR   = leg > 0 ? (f.isbull ? (fibTgt - close) : (close - fibTgt)) / riskDist : 0.0
                            target := fibR >= minRr ? fibTgt : rrTarget

                        else if tpMode == "Prior Swing Liquidity"
                            liq  = f.isbull ? prevDayHigh : prevDayLow
                            liqR = na(liq) ? 0.0 : (f.isbull ? (liq - close) : (close - liq)) / riskDist
                            target := liqR >= minRr ? liq : rrTarget

                        rawQty = (strategy.equity * riskPct / 100) / riskDist
                        qty    = math.min(rawQty, strategy.equity * maxLeverage / close)
                        id     = (f.isbull ? "BullFVG_" : "BearFVG_") + str.tostring(bar_index) + "_" + str.tostring(i)

                        sumRisk += riskDist

                        strategy.entry(id, f.isbull ? strategy.long : strategy.short, qty = qty)
                        strategy.exit(id, id, stop = stopLvl, limit = target)

                        if showLevels
                            line.new(bar_index, stopLvl, bar_index + 10, stopLvl, color = color.red,   style = line.style_dotted)
                            line.new(bar_index, target,  bar_index + 10, target,  color = color.green, style = line.style_dotted)

                        f.area.set_bgcolor(color.new(css, 30))
                        f.area.set_border_width(2)
                        fvgEntered += 1
                    else
                        //Retested and held, but a filter rejected the setup
                        f.area.set_bgcolor(color.new(css, 75))
                        fvgBlocked += 1

                array.remove(activeFvgs, i)
                alive := false

            else if aged
                fvgExpired += 1
                box.delete(f.area)
                line.delete(f.lvl)
                array.remove(activeFvgs, i)
                alive := false

        if alive
            f.area.set_right(bar_index)
            f.lvl.set_x2(bar_index)

//-----------------------------------------------------------------------------}
//Stats table — reads the retest hit rate directly instead of inferring it from PnL
//-----------------------------------------------------------------------------{
var table st = table.new(position.top_right, 2, 14, border_width = 1, border_color = color.gray)

row(r, k, v, txtCss) =>
    table.cell(st, 0, r, k, text_color = color.gray,  text_size = size.small, text_halign = text.align_left)
    table.cell(st, 1, r, v, text_color = txtCss,      text_size = size.small, text_halign = text.align_right)

if showStats and barstate.islast
    closed   = strategy.closedtrades
    winRate  = closed > 0 ? strategy.wintrades / closed * 100 : 0.0
    pf       = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0.0
    netPct   = strategy.netprofit / strategy.initial_capital * 100
    bhPct    = na(firstClose) ? 0.0 : (close / firstClose - 1) * 100
    tapRate  = fvgFormed > 0 ? fvgTapped / fvgFormed * 100 : 0.0
    avgRisk  = fvgEntered > 0 ? sumRisk / fvgEntered : 0.0
    costPct  = avgRisk > 0 ? (2 * feePctSide / 100 * close) / avgRisk * 100 : 0.0

    table.cell(st, 0, 0, "FVG Retest Stats", text_color = color.white, text_size = size.small)
    table.cell(st, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.white, text_size = size.small)

    row(1,  "FVGs formed",        str.tostring(fvgFormed),                          color.white)
    row(2,  "Retested",           str.tostring(fvgTapped) + "  (" + str.tostring(tapRate, "#.#") + "%)", color.white)
    row(3,  "Entries taken",      str.tostring(fvgEntered),                         color.aqua)
    row(4,  "Blocked by filters", str.tostring(fvgBlocked),                         color.orange)
    row(5,  "Closed through",     str.tostring(fvgInvalidated),                     color.red)
    row(6,  "Expired unfilled",   str.tostring(fvgExpired),                         color.gray)
    row(7,  "Closed trades",      str.tostring(closed),                             color.white)
    row(8,  "Win rate",           str.tostring(winRate, "#.#") + "%",               winRate >= 100 / (1 + rrMultiple) ? color.lime : color.red)
    row(9,  "Profit factor",      str.tostring(pf, "#.###"),                        pf >= 1 ? color.lime : color.red)
    row(10, "Strategy return",    str.tostring(netPct, "#.#") + "%",                netPct >= 0 ? color.lime : color.red)
    row(11, "Buy & hold",         str.tostring(bhPct, "#.#") + "%",                 bhPct >= 0 ? color.lime : color.red)
    row(12, "Avg risk (ticks)",   str.tostring(avgRisk / syminfo.mintick, "#"),     color.white)
    row(13, "Cost / risk",        str.tostring(costPct, "#.#") + "%",               costPct <= 5 ? color.lime : costPct <= 12 ? color.orange : color.red)
