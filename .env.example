NODE_ENV=development
WEB_PORT=8080
PORT=4000
API_PORT=4000
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
# Optional legacy OpenAI configuration
OPENAI_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4.1
LLM_TEMPERATURE=0.1
# Optional: powers the analytics AI coach and COT interpretation cards
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: official Census economic indicators (retail sales, housing, durable goods)
CENSUS_API_KEY=replace-with-your-census-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=tradepilot
PUBLIC_APP_URL=https://tradepilot.yassinecastro.com
REDIS_URL=redis://localhost:6379
# Optional: enables the HTTP Basic-authenticated queue dashboard at /admin/queues
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=replace-with-at-least-16-random-characters
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USER=replace-with-your-mailersend-smtp-user
SMTP_PASSWORD=replace-with-your-mailersend-smtp-password
SMTP_FROM=noreply@tradepilot.yassinecastro.com
SMTP_FROM_NAME=TradePilot
DISPATCH_RETRY_COUNT=3
DISPATCH_RETRY_DELAY_MS=750
EA_HEARTBEAT_TIMEOUT_MS=30000
EA_SERVER_PING_INTERVAL_MS=10000
EA_PRESENCE_TTL_MS=45000
EA_DISPATCH_ACK_TIMEOUT_MS=2000
API_KEY_ROTATION_GRACE_HOURS=24
API_KEY_LAST_USED_THROTTLE_MS=60000
RISK_MIN_TRADES_FOR_ADVANCED_METRICS=30
VITE_API_BASE_URL=http://localhost:4000/api
VITE_WS_BASE_URL=ws://localhost:4000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
VITE_MAGIC_LINK_REDIRECT_PATH=/auth/callback

# Production example for Docker + Nginx Proxy Manager:
# NODE_ENV=production
# CORS_ORIGIN=https://tradepilot.yassinecastro.com
# ALLOWED_ORIGINS=https://tradepilot.yassinecastro.com
# VITE_API_BASE_URL=/api
# VITE_WS_BASE_URL=auto
# VITE_MAGIC_LINK_REDIRECT_PATH=/auth/callback
# Add this redirect URL in Supabase Auth:
# https://tradepilot.yassinecastro.com/auth/callback
