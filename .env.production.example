NODE_ENV=production
WEB_PORT=8080
PORT=4000
API_PORT=4000
CORS_ORIGIN=https://tradepilot.yassinecastro.com
ALLOWED_ORIGINS=https://tradepilot.yassinecastro.com
OPENAI_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-5.2
LLM_TEMPERATURE=0.1
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
CENSUS_API_KEY=replace-with-your-census-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_SCHEMA=tradepilot
PUBLIC_APP_URL=https://tradepilot.yassinecastro.com
REDIS_URL=redis://redis:6379
# Enables the HTTP Basic-authenticated queue dashboard at /admin/queues
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=replace-with-at-least-16-random-characters
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=replace-with-your-smtp-user
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=noreply@tradepilot.app
DISPATCH_RETRY_COUNT=3
DISPATCH_RETRY_DELAY_MS=750
EA_HEARTBEAT_TIMEOUT_MS=30000
EA_SERVER_PING_INTERVAL_MS=10000
EA_PRESENCE_TTL_MS=45000
EA_DISPATCH_ACK_TIMEOUT_MS=2000
RISK_MIN_TRADES_FOR_ADVANCED_METRICS=30
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=auto
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
VITE_MAGIC_LINK_REDIRECT_PATH=/auth/callback

# Supabase Auth redirect URLs should include:
# https://tradepilot.yassinecastro.com/auth/callback
